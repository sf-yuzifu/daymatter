{
  "name": "daymatter",
  "version": "2.1",
  "description": "倒数日",
  "author": "[小鱼yuzifu](https://www.bandbbs.cn/members/969142/)",
  "email": "yzf@yzf.moe",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release --enable-jsc --drop-console log,debug,info",
    "analyze:size": "node tools/analyze-size.cjs",
    "check:budget": "node tools/check-image-budget.cjs",
    "optimize:png": "node tools/optimize-png.cjs",
    "test:ime": "node --test tools/test-ime.cjs",
    "test:date": "node --test tools/test-date.cjs",
    "test:store": "node --test tools/test-store.cjs",
    "test:watchface": "node --test tools/test-watchface.cjs",
    "test:memory": "node --expose-gc --test tools/test-ime.cjs",
    "test": "node --test tools/test-ime.cjs tools/test-date.cjs tools/test-store.cjs tools/test-watchface.cjs tools/test-background.cjs",
    "lint": "eslint src tools",
    "format:check": "prettier --check eslint.config.cjs tools/check-project.cjs tools/check-release-css.cjs",
    "check": "npm run lint && node tools/check-project.cjs && npm run format:check",
    "check:release": "node tools/check-release-css.cjs"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "adm-zip": "^0.5.16",
    "aiot-toolkit": "^2.0.5",
    "eslint": "^9",
    "eslint-plugin-html": "^8",
    "prettier": "^3"
  }
}
