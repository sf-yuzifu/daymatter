{
  "name": "daymatter",
  "version": "2.1",
  "description": "倒数日",
  "author": "[小鱼yuzifu](https://www.bandbbs.cn/members/969142/)",
  "email": "yzf@yzf.moe",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18.10"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release --enable-jsc --drop-console log,debug,info --optimize-css-attr",
    "analyze:size": "node tools/analyze-size.cjs",
    "check:budget": "node tools/check-image-budget.cjs",
    "optimize:png": "node tools/optimize-png.cjs",
    "test:ime": "node --test tools/test-ime.cjs",
    "test:date": "node --test tools/test-date.cjs",
    "test:store": "node --test tools/test-store.cjs",
    "test:memory": "node --expose-gc --test tools/test-ime.cjs",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/"
  },
  "lint-staged": {
    "*.{ux,js}": [
      "prettier --write",
      "eslint --format codeframe --fix",
      "git add"
    ],
    "*.{less,css}": [
      "prettier --write",
      "stylelint --fix --custom-syntax postcss-less",
      "git add"
    ]
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "adm-zip": "^0.5.16",
    "aiot-toolkit": "^2.0.5"
  }
}
