<script>
import device from "@system.device";

let screenSize = { width: 0, height: 0 };

device.getInfo({
	success: function (deviceRet) {
		screenSize.width = deviceRet.screenWidth;
		screenSize.height = deviceRet.screenHeight;
		global.screenShape = deviceRet.screenShape;
		global.screenSize = screenSize;
		global.isPillShaped = deviceRet.screenShape !== 'rect' && deviceRet.screenShape !== 'circle';
	},
});

global.dateDiff = (date1) => {
  const _date = new Date()
  const date = _date.getFullYear() + "-" + (_date.getMonth() + 1) + "-" + _date.getDate()
  return Math.floor((new Date(date).getTime() - new Date(date1).getTime()) / (1000 * 60 * 60 * 24))
}

global.getTime = function () {
	const date = new Date();
	const hour = date.getHours().toString().padStart(2, "0");
	const minute = date.getMinutes().toString().padStart(2, "0");
	return hour + ":" + minute;
};

global.formatEvent = (event, t, options = {}) => {
  const { withDaysSuffix = false, withFontSize = false } = options
  let days, font_size, display_name = event.name, already = true

  const diff = global.dateDiff(event.date)
  if (diff > 0) {
    if (event.IFStaringDay) {
      display_name += t("already")
      days = String(diff + 1)
    } else {
      display_name += t("already")
      days = String(diff)
    }
  } else if (diff == 0) {
    if (event.IFStaringDay) {
      display_name += t("already")
      days = String(diff + 1)
    } else {
      days = t("today")
    }
  } else {
    display_name += t("remaining")
    days = String(-diff)
    already = false
  }

  let resultDays = days
  if (withDaysSuffix && days !== t("today")) {
    resultDays += t("days")
  }

  if (withFontSize) {
    const days_length = String(days).length
    if (days == t("today")) {
      font_size = 26
    } else if (days_length < 3) {
      font_size = 30
    } else if (days_length == 3) {
      font_size = 28
    } else {
      font_size = 20
    }
  }

  const result = {
    name: event.name,
    display_name,
    date: event.date,
    days: resultDays,
    already,
    on_index: event.on_index,
    IFStaringDay: event.IFStaringDay || false
  }

  if (withFontSize) {
    result.font_size = font_size
  }

  return result
}

export default {}
</script>
