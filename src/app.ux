<script>
import device from "@system.device"

let screenSize = {width: 0, height: 0}

device.getInfo({
  success: function (deviceRet) {
    screenSize.width = deviceRet.screenWidth
    screenSize.height = deviceRet.screenHeight
    global.screenShape = deviceRet.screenShape
    global.screenSize = screenSize
    global.deviceType = deviceRet.deviceType
    global.isPillShaped = deviceRet.screenShape !== "rect" && deviceRet.screenShape !== "circle"
  }
})

global.dateDiff = (date1) => {
  const _date = new Date()
  const date = _date.getFullYear() + "-" + (_date.getMonth() + 1) + "-" + _date.getDate()
  return Math.floor((new Date(date).getTime() - new Date(date1).getTime()) / (1000 * 60 * 60 * 24))
}

global.getDateDiffAccurate = (targetDate) => {
  const today = new Date()
  const target = new Date(targetDate)

  // 确保日期是有效的
  if (isNaN(today.getTime()) || isNaN(target.getTime())) {
    return { years: 0, months: 0, days: 0, totalDays: 0 }
  }

  // 判断哪个日期在前
  const isTargetFuture = target.getTime() > today.getTime()

  // 确保 startDate 是较早的日期，endDate 是较晚的日期
  const startDate = isTargetFuture ? today : target
  const endDate = isTargetFuture ? target : today

  let years = endDate.getFullYear() - startDate.getFullYear()
  let months = endDate.getMonth() - startDate.getMonth()
  let days = endDate.getDate() - startDate.getDate()

  // 调整天数为负数的情况
  if (days < 0) {
    months--
    // 获取上一个月的天数
    const lastMonth = new Date(endDate.getFullYear(), endDate.getMonth(), 0)
    days += lastMonth.getDate()
  }

  // 调整月份为负数的情况
  if (months < 0) {
    years--
    months += 12
  }

  // 计算总天数差（用于判断事件状态）
  const totalDays = Math.floor((today.getTime() - target.getTime()) / (1000 * 60 * 60 * 24))

  return { years, months, days, totalDays }
}

global.getTime = function () {
  const date = new Date()
  const hour = date.getHours().toString().padStart(2, "0")
  const minute = date.getMinutes().toString().padStart(2, "0")
  return hour + ":" + minute
}

global.adjustThemeColor = (baseColor, already) => {
  // 如果没有设置主题色，使用默认颜色
  if (!baseColor) {
    return already ? "#f78803" : "#3184d0"
  }

  // 色调映射表：基础色 -> [已过去色调, 未到来色调]
  const colorMap = {
    "#3184d0": ["#f78803", "#3184d0"],
    "#f78803": ["#fdb763", "#f78803"],
    "#e74c3c": ["#e74c3c", "#f29f97"],
    "#27ae60": ["#104627", "#27ae60"],
    "#9b59b6": ["#532c64", "#9b59b6"]
  }

  const colors = colorMap[baseColor]
  if (colors) {
    return already ? colors[0] : colors[1]
  }

  return baseColor
}

export default {}
</script>
