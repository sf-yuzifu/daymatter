<script>
import device from "@system.device"
import file from "@system.file"
import gcGuard from "./components/gcGuard"
import minuteTicker from "./components/minuteTicker"
import dateUtils from "./components/dateUtils"
import eventStoreFactory from "./components/eventStore"

let screenSize = {width: 0, height: 0}

// 低频 GC 守卫：页面释放大块数据后按需调用，宿主持有 runGC 时才真正执行
global.tryRunGC = gcGuard.createGcGuard()

// 前台分钟级时钟：页面可见时启动、隐藏停止，跨午夜上报日期变化
global.createMinuteTicker = minuteTicker.createMinuteTicker

// 日期工具：显式解析与日历日算法，页面统一通过 global.dateUtils 使用
global.dateUtils = dateUtils

// 事件存储：腕端与插件消息统一走同一读写 / 校验 / 原子提交入口
global.eventStore = eventStoreFactory.createEventStore({file: file, dateUtils: dateUtils})

// 设备信息就绪前的默认形态：胶囊 / 跑道屏是设计基准
global.screenShape = "pill-shaped"
global.isPillShaped = true

device.getInfo({
  success: function (deviceRet) {
    screenSize.width = deviceRet.screenWidth
    screenSize.height = deviceRet.screenHeight
    global.screenShape = deviceRet.screenShape
    global.screenSize = screenSize
    global.deviceType = deviceRet.deviceType
    // 非 rect / circle（含缺失与未知值）一律按胶囊基准，与页面 else 分支一致
    global.isPillShaped = deviceRet.screenShape !== "rect" && deviceRet.screenShape !== "circle"
  }
})

global.getTime = function () {
  const date = new Date()
  const hour = date.getHours().toString().padStart(2, "0")
  const minute = date.getMinutes().toString().padStart(2, "0")
  return hour + ":" + minute
}

const THEME_COLOR_MAP = Object.freeze({
  "#3184d0": Object.freeze(["#f78803", "#3184d0"]),
  "#f78803": Object.freeze(["#fdb763", "#f78803"]),
  "#e74c3c": Object.freeze(["#e74c3c", "#f29f97"]),
  "#27ae60": Object.freeze(["#104627", "#27ae60"]),
  "#9b59b6": Object.freeze(["#532c64", "#9b59b6"])
})

const B64_LOOKUP = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

global.adjustThemeColor = (baseColor, already) => {
  // 如果没有设置主题色，使用默认颜色
  if (!baseColor) {
    return already ? "#f78803" : "#3184d0"
  }

  const colors = THEME_COLOR_MAP[baseColor]
  if (colors) {
    return already ? colors[0] : colors[1]
  }

  return baseColor
}

global.base64ToArrayBuffer = (base64) => {
  base64 = base64.replace(/[\s\r\n]/g, "")
  const len = base64.length
  if (len === 0) return new ArrayBuffer(0)

  let paddingCount = 0
  if (base64.charAt(len - 1) === "=") paddingCount++
  if (base64.charAt(len - 2) === "=") paddingCount++

  const bufferLength = (len * 3) / 4 - paddingCount
  const bytes = new Uint8Array(bufferLength)

  let p = 0
  for (let i = 0; i < len; i += 4) {
    const encoded1 = B64_LOOKUP.indexOf(base64[i])
    const encoded2 = B64_LOOKUP.indexOf(base64[i + 1])
    const encoded3 = B64_LOOKUP.indexOf(base64[i + 2])
    const encoded4 = B64_LOOKUP.indexOf(base64[i + 3])

    if (encoded1 < 0 || encoded2 < 0) continue

    bytes[p++] = (encoded1 << 2) | (encoded2 >> 4)
    if (encoded3 !== -1 && encoded3 !== 64 && p < bufferLength) {
      bytes[p++] = ((encoded2 & 15) << 4) | (encoded3 >> 2)
    }
    if (encoded4 !== -1 && encoded4 !== 64 && p < bufferLength) {
      bytes[p++] = ((encoded3 & 3) << 6) | (encoded4 & 63)
    }
  }
  return bytes.buffer
}

export default {}
</script>
