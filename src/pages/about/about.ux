<template>
  <div class="container">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">{{ $t("about") }}</text>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <text @click="routeBack" class="title" elif="{{ global.screenShape == 'circle' }}">
      <span class="iconfont">&#xe685;</span>
      <span>{{ $t("about") }}</span>
    </text>
    <img else class="top" src="/common/back.png" @click="routeBack" />
    <text class="bold spacer-large"></text>
    <div class="box">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <div id="info">
          <div id="inner">
            <text class="bold app-name">{{ $t("appName") }}</text>
            <text id="version" class="re">{{ ver }}</text>
          </div>
          <div id="logo-container">
            <image id="logo" src="/common/logo.png" />
          </div>
        </div>
        <div class="background-settings">
          <text class="background-label">{{ $t("backgroundTitle") }}</text>
          <text class="background-state">{{ $t(backgroundState) }}</text>
          <text class="background-action" if="{{ hasBackground && !confirmReset }}" @click="askReset">{{ $t("restoreBackground") }}</text>
          <div class="background-confirm" if="{{ confirmReset }}">
            <text class="background-state">{{ $t("restoreBackgroundConfirm") }}</text>
            <text class="background-action" @click="cancelReset">{{ $t("cancel") }}</text>
            <text class="background-action" @click="resetBackground">{{ $t("restoreBackground") }}</text>
          </div>
        </div>
        <div id="copyright">
          <text class="re bold" if="{{ global.isPillShaped }}">
            {{ $t("author") }}
          </text>
          <text class="re bold">
            <span if="{{ !global.isPillShaped }}">
              {{ $t("author") }}
            </span>
            <!-- 这里是占位符 -->
            <span if="{{ !global.isPillShaped }}" style="color: transparent">2</span>
            <span class="bold white">小鱼yuzifu</span>
          </text>
          <div class="spacer" if="{{ !global.isPillShaped }}"></div>
          <text class="re bold" if="{{ !global.isPillShaped }}">
            {{ $t("thanks") }}
          </text>
          <text class="bold white">chiyuki0325</text>
          <text class="bold white">NEORUAA</text>
          <text class="bold white">无源流沙</text>
        </div>
        <div class="padding"></div>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import app from "@system.app"
import {showToast} from "@system.prompt"

export default {
  private: {
    ver: app.getInfo().versionName,
    time: "",
    hasBackground: false,
    backgroundState: "backgroundDefault",
    confirmReset: false
  },

  onInit() {
    this._ticker = global.createMinuteTicker(() => this.handleMinuteTick())
  },

  handleMinuteTick() {
    this.time = global.getTime()
  },

  onShow() {
    this._visible = true
    const token = (this._loadToken || 0) + 1
    this._loadToken = token
    global.backgroundStore.load((error, uri) => {
      if (this._destroyed || !this._visible || token !== this._loadToken) return
      this.hasBackground = !error && !!uri
      this.backgroundState = error ? "backgroundReadFail" : uri ? "backgroundCustom" : "backgroundDefault"
    })
    this.time = global.getTime()
    this._ticker.start()
  },

  onHide() {
    this._visible = false
    this.confirmReset = false
    this._ticker.stop()
  },

  onDestroy() {
    this._destroyed = true
    this._ticker.stop()
  },

  routeBack() {
    if (this.confirmReset && !this._resetting) { this.confirmReset = false; return }
    router.back()
  },

  askReset() {
    if (!this._resetting) this.confirmReset = true
  },

  cancelReset() {
    if (!this._resetting) this.confirmReset = false
  },

  resetBackground() {
    if (this._resetting || !this.confirmReset) return
    this._resetting = true
    global.backgroundStore.reset((error) => {
      this._resetting = false
      if (this._destroyed) return
      if (!error) {
        this.hasBackground = false
        this.backgroundState = "backgroundDefault"
        this.confirmReset = false
        this._loadToken = (this._loadToken || 0) + 1
      }
      if (this._visible) showToast({message: this.$t(error ? "bgSaveFail" : "backgroundResetSuccess"), duration: 2000})
    })
  }
}
</script>

<style>
@import "../../common/app.css";

.container {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.spacer {
  width: 1px;
  height: 10px;
}

.spacer-large {
  height: 116px;
}

.app-name {
  color: #fff;
  font-size: 30px;
}

.white {
  color: #fff;
  font-size: 28px;
}

#info {
  flex-direction: column;
  justify-content: center;
  border: 3px solid rgba(255, 255, 255, 0.06);
  background-color: #262626;
  border-radius: 20px;
  padding: 10px 20px;
  width: 90%;
}

#logo-container {
  width: 100%;
  flex-direction: column;
  align-items: flex-end;
}

#inner {
  align-items: flex-start;
  justify-content: space-between;
  flex-direction: column;
  width: 100%;
}

#logo {
  width: 56px;
}

#version {
  font-size: 24px;
}

#copyright {
  margin-top: 10px;
  width: 90%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.re {
  color: #999;
}

.bold {
  font-weight: bold;
}

.box {
  position: relative;
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.background-settings {
  width: 90%;
  flex-direction: column;
  border: 3px solid rgba(255, 255, 255, 0.06);
  background-color: #262626;
  border-radius: 20px;
  padding: 12px;
  margin-top: 12px;
}

.background-label {
  color: white;
  font-size: 24px;
}

.background-state {
  color: #999;
  font-size: 22px;
}

.background-action {
  color: #3184d0;
  font-size: 24px;
  min-height: 48px;
}

.background-confirm {
  flex-direction: column;
  width: 100%;
}

@media (shape: rect) {
  .background-settings { width: 83%; }
}

@media (device-type: watch) and (shape: rect) {
  .background-settings { width: 75%; }
}

@media (shape: circle) {
  .background-settings { width: 70%; }
}

@media (shape: rect) {
  #logo {
    width: 76px;
  }

  .white {
    font-size: unset;
  }
}

@media (device-type: band) and (shape: rect) {
  .spacer-large {
    height: 80px;
  }

  #info {
    width: 83%;
  }

  #copyright {
    width: 83%;
    align-items: flex-start;
  }
}

@media (device-type: watch) and (shape: rect) {
  .spacer-large {
    height: 94px;
  }

  #info {
    width: 75%;
  }

  #copyright {
    width: 75%;
    align-items: flex-start;
  }
}

@media (device-type: watch) and (shape: circle) {
  .spacer-large {
    height: 84px;
  }

  #info {
    width: 70%;
  }

  #copyright {
    width: 70%;
    align-items: flex-start;
  }

  #logo {
    width: 76px;
  }

  .white {
    font-size: unset;
  }

  .padding {
    height: 72px;
  }
}
</style>
