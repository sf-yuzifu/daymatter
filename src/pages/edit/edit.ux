<template>
  <div class="new-page">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">
      {{ extend == "true" ? $t("addEvent") : $t("editEvent") }}
    </text>
    <div class="box padding" if="{{ contentVisible }}">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <div class="line field-card">
          <text class="field-label input-label">{{ $t("eventName") }}</text>
          <div class="input-line" @click="editEventName">
            <scroll
              class="input-scroll"
              scroll-x="true"
            >
              <text class="input-text">
                {{ event_name }}
              </text>
            </scroll>
          </div>
        </div>
        <div class="line field-card">
          <text class="field-label input-label">{{ $t("targetDateLabel") }}</text>
          <div class="input-line" @click="editDate">
            <scroll
              class="input-scroll"
              scroll-x="true"
            >
              <text class="input-text">{{ date }}</text>
            </scroll>
          </div>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee if="{{ global.isPillShaped && pageVisible }}" scrollamount="20" text-offset="20">{{ $t("showOnHome") }}</marquee>
            <text class="setting-label" else>{{ $t("showOnHome") }}</text>
            <marquee class="setting-info" if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}" scrollamount="20" text-offset="20">{{ $t("showOnHomeInfo") }}</marquee>
          </div>
          <img if="{{ global.isPillShaped }}" style="height: 48px" src="/common/{{ on_index }}.png" @click="changeDisplayOnIndex" />
          <switch else class="setting-switch" checked="{{ on_index === true || on_index === 'true' }}" @change="onHomeChange"></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee if="{{ global.isPillShaped && pageVisible }}" scrollamount="20" text-offset="20">{{ $t("useAsWatchface") }}</marquee>
            <text class="setting-label" else>{{ $t("useAsWatchface") }}</text>
            <marquee class="setting-info" if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}" scrollamount="20" text-offset="20">{{ $t("useAsWatchfaceInfo") }}</marquee>
          </div>
          <img if="{{ global.isPillShaped }}" style="height: 48px" src="/common/{{ useWatchface }}.png" @click="changeUseWatchface" />
          <switch else class="setting-switch" checked="{{ useWatchface === true || useWatchface === 'true' }}" @change="onWatchfaceChange"></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee if="{{ global.isPillShaped && pageVisible }}" scrollamount="20" text-offset="20">{{ $t("includeStartDay") }}</marquee>
            <text class="setting-label" else>{{ $t("includeStartDay") }}</text>
            <marquee class="setting-info" if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}" scrollamount="20" text-offset="20">{{ $t("includeStartDayInfo") }}</marquee>
          </div>
          <img if="{{ global.isPillShaped }}" style="height: 48px" src="/common/{{ IFStaringDay }}.png" @click="changeDisplayIFStaringDay" />
          <switch else class="setting-switch" checked="{{ IFStaringDay === true || IFStaringDay === 'true' }}" @change="onStartDayChange"></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee if="{{ global.isPillShaped && pageVisible }}" scrollamount="20" text-offset="20">{{ $t("annualRepeat") }}</marquee>
            <text class="setting-label" else>{{ $t("annualRepeat") }}</text>
            <marquee class="setting-info" if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}" scrollamount="20" text-offset="20">{{ $t("annualRepeatInfo") }}</marquee>
          </div>
          <div if="{{ global.isPillShaped }}">
            <img if="{{ repeat === 'yearly' }}" style="height: 48px" src="/common/true.png" @click="changeRepeat" />
            <img else style="height: 48px" src="/common/false.png" @click="changeRepeat" />
          </div>
          <switch else class="setting-switch" checked="{{ repeat === 'yearly' }}" @change="onRepeatChange"></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <text class="setting-label">{{ $t("displayUnit") }}</text>
            <marquee class="setting-info" if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}" scrollamount="20" text-offset="20">{{ $t("displayUnitInfo") }}</marquee>
          </div>
          <picker class="unit-picker" type="text" range="{{ unitOptions }}" selected="{{ unitKeys.indexOf(displayUnit) }}" @change="onUnitChange"></picker>
        </div>
        <div class="line color-picker-container">
          <text class="field-label">{{ $t("themeColor") }}</text>
          <marquee class="setting-info" if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}" scrollamount="20" text-offset="20">{{ $t("themeColorInfo") }}</marquee>
          <div class="color-picker">
            <div
              class="color-option"
              style="background-color: #3184d0; opacity: {{ themeColor === '#3184d0' ? 1 : 0.4 }}"
              @click="changeThemeColor('#3184d0')"
            ></div>
            <div
              class="color-option"
              style="background-color: #f78803; opacity: {{ themeColor === '#f78803' ? 1 : 0.4 }}"
              @click="changeThemeColor('#f78803')"
            ></div>
            <div
              class="color-option"
              style="background-color: #e74c3c; opacity: {{ themeColor === '#e74c3c' ? 1 : 0.4 }}"
              @click="changeThemeColor('#e74c3c')"
            ></div>
            <div
              class="color-option"
              style="background-color: #27ae60; opacity: {{ themeColor === '#27ae60' ? 1 : 0.4 }}"
              @click="changeThemeColor('#27ae60')"
            ></div>
            <div
              class="color-option"
              style="background-color: #9b59b6; opacity: {{ themeColor === '#9b59b6' ? 1 : 0.4 }}"
              @click="changeThemeColor('#9b59b6')"
            ></div>
          </div>
        </div>
      </scroll>
    </div>
    <img
      if="{{ extend != 'true' && global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/del_rect.png"
      @click="deleteEvent"
    />
    <img
      elif="{{ extend != 'true' && global.screenShape != 'rect' }}"
      class="top"
      src="/common/del.png"
      @click="deleteEvent"
    />
    <img
      elif="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <img else class="top" src="/common/back.png" @click="routeBack" />
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/check_rect.png"
      @click="saveEvent"
    />
    <img else class="bottom" src="/common/check.png" @click="saveEvent" />
  </div>
</template>

<script>
import router from "@system.router"
import {showToast} from "@system.prompt"

export default {
  private: {
    event_name: "",
    extend: "true",
    date: "",
    on_index: true,
    IFStaringDay: false,
    repeat: "none",
    displayUnit: "days",
    unitKeys: ["days", "weeks", "months", "years"],
    unitOptions: [],
    useWatchface: false,
    themeColor: "#3184d0",
    callback_uri: "/pages/index",
    event_id: "0",
    time: "",
    pageVisible: false,
    contentVisible: false
  },

  routeBack() {
    if (router.getLength() > 1) {
      router.back({path: this.callback_uri})
    } else {
      router.replace({uri: this.callback_uri})
    }
  },

  onInit() {
    this.unitOptions = this.unitKeys.map((unit) => this.$t(unit))
    this.repeat = this.repeat === "yearly" ? "yearly" : "none"
    if (["days", "weeks", "months", "years"].indexOf(this.displayUnit) < 0) this.displayUnit = "days"
    // 只用标量标记当前子页请求，不把编辑页对象存入全局。
    global.__daymatterEditSequence = (global.__daymatterEditSequence || 0) + 1
    this._editSessionId = String(global.__daymatterEditSequence)
    this._editRequestSequence = 0
    this._pendingField = ""
    this._pendingRequestId = ""
    this._destroyed = false
    this._saving = false
    // 表盘主事件与「首页展示」相互独立：进入时的状态决定保存时是否需要切换
    this._wasWatchface = this.watchface === true || this.watchface === "true"
    this.useWatchface = this._wasWatchface
    this._primaryChange = false
    this._ticker = global.createMinuteTicker(() => this.handleMinuteTick())
    // 统一日期格式：旧数据 / 插件参数中的 YYYY-M-D 归一到 YYYY-MM-DD，非法值回退今天
    const normalizedDate = global.dateUtils.normalizeDate(this.date)
    if (normalizedDate) {
      this.date = normalizedDate
    } else {
      const today = global.dateUtils.todayParts()
      this.date = global.dateUtils.formatDate(today.year, today.month, today.day)
    }
  },

  onShow() {
    this.pageVisible = true
    this.contentVisible = true
    this.time = global.getTime()
    if (this._pendingField === "event_name") {
      if (global.__daymatterImeOwner === this._pendingRequestId) {
        const result = global.__imeResult
        this.clearImeResult()
        // 返回键取消时保留原名称，确认只更新草稿，不立即写盘。
        if (result && result.confirmed === true && typeof result.text === "string") {
          this.event_name = result.text
        }
      }
    } else if (this._pendingField === "date") {
      const result = global.__daymatterDateResult
      if (result && result.requestId === this._pendingRequestId) {
        const normalized = global.dateUtils.normalizeDate(result.date)
        if (normalized) this.date = normalized
        global.__daymatterDateResult = null
      }
    }
    this._pendingField = ""
    this._pendingRequestId = ""
    this._ticker.start()
  },

  handleMinuteTick() {
    if (this._destroyed) return
    // 编辑页只显示当前时间，目标日期草稿不随时钟变化
    this.time = global.getTime()
  },

  onHide() {
    // 离开页面时移除跑马灯与表单节点，停止滚动与分钟时钟；草稿数据保留在 this 中
    this.pageVisible = false
    this.contentVisible = false
    this._ticker.stop()
  },

  onDestroy() {
    this._destroyed = true
    this._ticker.stop()
    this.clearImeResult()
    const result = global.__daymatterDateResult
    if (result && result.requestId === this._pendingRequestId) {
      global.__daymatterDateResult = null
    }
    this._pendingField = ""
    this._pendingRequestId = ""
    this.event_name = ""
    this._saving = false
  },

  clearImeResult() {
    if (!this._pendingRequestId || global.__daymatterImeOwner !== this._pendingRequestId) return
    global.__imeText = ""
    global.__imeLabel = ""
    global.__imeResult = null
    global.__daymatterImeOwner = null
  },

  editEventName() {
    if (this._pendingField) return
    this._pendingField = "event_name"
    this._pendingRequestId = this._editSessionId + ":" + ++this._editRequestSequence
    global.__daymatterImeOwner = this._pendingRequestId
    global.__imeText = this.event_name
    global.__imeLabel = this.$t("eventName")
    global.__imeResult = null
    router.push({uri: "/pages/ime"})
  },

  editDate() {
    if (this._pendingField) return
    this._pendingField = "date"
    this._pendingRequestId = this._editSessionId + ":" + ++this._editRequestSequence
    global.__daymatterDateResult = null
    router.push({
      uri: "/pages/datepicker",
      params: {
        date: this.date,
        requestId: this._pendingRequestId
      }
    })
  },

  changeDisplayOnIndex() {
    if (this.on_index === "true") {
      this.on_index = true
    } else if (this.on_index === "false") {
      this.on_index = false
    }
    this.on_index = !this.on_index
  },

  changeDisplayIFStaringDay() {
    if (this.IFStaringDay === "true") {
      this.IFStaringDay = true
    } else if (this.IFStaringDay === "false") {
      this.IFStaringDay = false
    }
    this.IFStaringDay = !this.IFStaringDay
  },

  changeUseWatchface() {
    if (this.useWatchface === "true") {
      this.useWatchface = true
    } else if (this.useWatchface === "false") {
      this.useWatchface = false
    }
    this.useWatchface = !this.useWatchface
  },

  changeThemeColor(color) {
    this.themeColor = color
  },

  onHomeChange(event) {
    this.on_index = event.checked
  },

  onWatchfaceChange(event) {
    this.useWatchface = event.checked
  },

  onStartDayChange(event) {
    this.IFStaringDay = event.checked
  },

  onRepeatChange(event) {
    this.repeat = event.checked ? "yearly" : "none"
  },

  changeRepeat() {
    this.repeat = this.repeat === "yearly" ? "none" : "yearly"
  },

  changeUnit() {
    const units = ["days", "weeks", "months", "years"]
    this.displayUnit = units[(units.indexOf(this.displayUnit) + 1) % units.length]
  },

  normalizeBoolean(value) {
    if (value === "true") return true
    if (value === "false") return false
    return value
  },

  onUnitChange(event) {
    const index = this.unitOptions.indexOf(event.newValue)
    if (index >= 0) this.displayUnit = this.unitKeys[index]
  },

  showErrorToast(code) {
    showToast({message: this.$t("saveFail", {code: code})})
  },

  saveEvent() {
    if (this._saving) return
    if (this.event_name == "") {
      showToast({message: this.$t("eventNameRequired")})
      return
    }

    // 只接受真实日历日期，按统一格式写入；非法日期不保存，避免写入不存在日期
    const normalizedDate = global.dateUtils.normalizeDate(this.date)
    if (!normalizedDate) {
      showToast({message: this.$t("dateInvalid")})
      return
    }
    this.date = normalizedDate

    this._saving = true
    const payload = {
      name: this.event_name,
      repeat: this.repeat,
      displayUnit: this.displayUnit,
      date: this.date,
      on_index: this.normalizeBoolean(this.on_index),
      IFStaringDay: this.normalizeBoolean(this.IFStaringDay),
      themeColor: this.themeColor
    }

    // 页面收到的「当前是否表盘事件」与开关最终值不一致才需要切换主事件
    const wantedWatchface = this.useWatchface === true || this.useWatchface === "true"
    this._primaryChange = wantedWatchface !== this._wasWatchface

    const finish = (error) => {
      if (this._destroyed) return
      if (error) {
        if (error.code === "WATCHFACE_FAIL") {
          // D-20 分项结果：事件数据已提交，仅表盘文件失败；离开页面避免重复新增
          showToast({message: this.$t("watchfaceSyncFail"), duration: 2000})
          this.routeBack()
          return
        }
        // 保存失败保留当前草稿与页面，不虚报成功（D-16）
        this._saving = false
        this.showEventError(error)
        return
      }
      showToast({message: this.$t("saveSuccess")})
      this.routeBack()
    }

    const onStored = (error, result) => {
      if (error) {
        finish(error)
        return
      }
      const id = this.extend === "true" ? result.event.id : String(this.event_id)
      if (!this._primaryChange) {
        finish(null)
        return
      }
      // 主事件切换单独提交，取消主事件传空串
      global.eventStore.setPrimary(wantedWatchface ? id : "", finish)
    }

    if (this.extend === "true") {
      global.eventStore.add(payload, onStored)
    } else {
      global.eventStore.update(String(this.event_id), payload, onStored)
    }
  },

  showEventError(error) {
    const code = error && error.code
    if (code === "NAME_REQUIRED") {
      showToast({message: this.$t("eventNameRequired")})
      return
    }
    if (code === "NAME_TOO_LONG" || code === "NAME_INVALID") {
      showToast({message: this.$t(code === "NAME_TOO_LONG" ? "eventNameTooLong" : "eventNameInvalid")})
      return
    }
    if (code === "DATE_INVALID") {
      showToast({message: this.$t("dateInvalid")})
      return
    }
    if (code === "EVENT_LIMIT") {
      showToast({message: this.$t("tooManyEvents")})
      return
    }
    if (code === "NOT_FOUND") {
      showToast({message: this.$t("eventNotFound")})
      return
    }
    if (
      code === "INVALID_BOOLEAN" ||
      code === "INVALID_REPEAT" || code === "INVALID_UNIT" ||
      code === "INVALID_COLOR" ||
      code === "INVALID_EVENT"
    ) {
      showToast({message: this.$t("invalidEvent")})
      return
    }
    const causeCode = error && error.cause ? error.cause.code : code
    this.showErrorToast(causeCode)
  },

  deleteEvent() {
    if (this._saving) return
    this._saving = true
    global.eventStore.remove(String(this.event_id), (error) => {
      if (this._destroyed) return
      if (error) {
        if (error.code === "WATCHFACE_FAIL") {
          // 事件已删除，仅表盘文件失败：报告分项结果后离开
          showToast({message: this.$t("watchfaceSyncFail"), duration: 2000})
          this.routeBack()
          return
        }
        this._saving = false
        this.showEventError(error)
        return
      }
      showToast({message: this.$t("deleteSuccess")})
      this.routeBack()
    })
  }
}
</script>

<style>
@import "../../common/app.css";

.new-page {
  flex-direction: column;
  align-items: center;
  color: white;
  background-color: black;
}

.padding {
  margin-top: 116px;
  margin-bottom: 86px;
}

.line {
  display: flex;
  flex-direction: column;
  justify-content: left;
   width: 92%;
}

text,
marquee {
  font-size: 24px;
  font-weight: bold;
}

.input-line {
  height: 60px;
  width: 100%;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 18px;
  margin-top: 10px;
  align-items: center;
  flex-shrink: 0;
}

.input-label {
  padding-left: 0px;
  min-height: 42px;
  flex-shrink: 0;
}

.input-scroll {
  width: 100%;
  height: 44px;
}

.input-text {
  lines: 1;
  height: 44px;
  line-height: 44px;
  color: #ffffff;
  padding: 0 12px;
}

.button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.unit-button {
  height: 48px;
  min-width: 72px;
  padding: 0 12px;
  margin-top: 4px;
  color: #ffffff;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 24px;
  text-align: center;
}

.color-picker-container {
  align-items: center;
}

.color-picker {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
  margin-top: 8px;
  margin-bottom: 20px;
}

.color-option {
  width: 48px;
  height: 48px;
  border-radius: 100%;
  margin-bottom: 10px;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.box {
  position: relative;
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

/* 跑道屏固定三列：42px 色块 + 左右各 2px，末行不再两端分散。 */
@media (shape: pill-shaped) {
  .input-label {
    min-height: 32px;
  }
  .input-line {
    height: 52px;
    margin-top: 8px;
    border-radius: 16px;
  }
  .color-picker {
    width: 138px;
    justify-content: flex-start;
  }

  .color-option {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    margin: 0 2px 10px;
  }
}

@media (device-type: band) and (shape: rect) {
  .line {
    width: 324px;
    max-width: 96%;
  }

  .color-picker-container {
    align-items: flex-start;
  }

  .button {
    flex-direction: row;
  }

  .padding {
    margin-top: 92px;
    margin-bottom: 16px;
  }

  .color-option {
    width: 42px;
    height: 42px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .line {
    width: 380px;
    max-width: 96%;
  }

  .button {
    flex-direction: row;
  }

  .color-picker-container {
    align-items: flex-start;
  }

  .padding {
    margin-top: 102px;
    margin-bottom: 32px;
  }

  .color-option {
    width: 48px;
    height: 48px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .padding {
    margin-top: 92px;
    margin-bottom: 84px;
  }

  .line {
    width: 380px;
    max-width: 96%;
  }

  .button {
    flex-direction: row;
  }

  .color-picker-container {
    align-items: flex-start;
  }

  .color-option {
    width: 48px;
    height: 48px;
  }
}
/* 圆角卡片沿用漫画设置页风格，宽度按当前设备布局。 */
.field-card,
.button,
.color-picker-container {
  flex-shrink: 0;
  margin-bottom: 10px;
  padding: 12px;
  border-radius: 24px;
  background-color: #262626;
}

.input-line,
.unit-button {
  background-color: #363636;
}

.setting-label {
  min-width: 0px;
  width: 100%;
  min-height: 42px;
  font-size: 32px;
  font-weight: bold;
  flex-shrink: 0;
  color: #ffffff;
}

.setting-content {
  flex: 1;
  min-width: 0px;
  flex-direction: column;
}

.setting-info {
  width: 100%;
  height: 36px;
  flex-shrink: 0;
  font-size: 28px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 5px;
  lines: 1;
}

.setting-switch {
  height: 36px;
  width: 64px;
  flex-shrink: 0;
  margin-top: 8px;
}

.color-picker {
  margin-bottom: 0px;
}

@media (shape: pill-shaped) {
  .setting-label {
    font-size: 24px;
    min-height: 32px;
  }
  .setting-content {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 100%;
  }
  .setting-label {
    width: 100%;
    text-align: center;
  }

  .unit-button {
    width: 80px;
  }
}

@media (shape: rect) {
  .field-label,
  .input-text,
  .unit-button {
    font-size: 32px;
  }
  .setting-info {
    font-size: 28px;
  }
  .setting-switch {
    margin-top: 0px;
    margin-left: 10px;
  }
}

@media (shape: circle) {
  .field-label,
  .input-text,
  .unit-button {
    font-size: 32px;
  }
  .setting-info {
    font-size: 28px;
  }
