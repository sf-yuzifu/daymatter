<template>
  <div class="new-page">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">
      {{ extend == "true" ? $t("addEvent") : $t("editEvent") }}
    </text>
    <div class="box padding" if="{{ contentVisible }}">
      <scroll class="box" scroll-x="false" scroll-y="true" bounces="true">
        <div class="line" style="margin-bottom: 10px">
          <text style="margin-left: 14px">{{ $t("eventName") }}</text>
          <div class="input-line" @click="editEventName">
            <scroll
              style="position: absolute; width: 100%; height: 42px; margin: 6px 0"
              scroll-x="true"
            >
              <text class="input-text">
                {{ event_name }}
              </text>
            </scroll>
          </div>
        </div>
        <div class="line" style="margin-bottom: 8px">
          <text style="margin-left: 14px">{{ $t("targetDateLabel") }}</text>
          <div class="input-line" @click="editDate">
            <scroll
              style="position: absolute; width: 100%; height: 42px; margin: 6px 0"
              scroll-x="true"
            >
              <text class="input-text">{{ date }}</text>
            </scroll>
          </div>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <marquee if="{{ pageVisible }}" scrollamount="{{ 20 }}" text-offset="{{ 20 }}">
            {{ $t("showOnHome") }}
          </marquee>
          <text else>{{ $t("showOnHome") }}</text>
          <img
            style="height: 48px"
            @click="changeDisplayOnIndex"
            src="/common/{{ on_index }}.png"
          />
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <marquee if="{{ pageVisible }}" scrollamount="{{ 20 }}" text-offset="{{ 20 }}">
            {{ $t("includeStartDay") }}
          </marquee>
          <text else>{{ $t("includeStartDay") }}</text>
          <img
            style="height: 48px"
            @click="changeDisplayIFStaringDay"
            src="/common/{{ IFStaringDay }}.png"
          />
        </div>
        <div class="line color-picker-container">
          <text>{{ $t("themeColor") }}</text>
          <div class="color-picker">
            <div
              class="color-option"
              style="background-color: #3184d0; opacity: {{ themeColor === '#3184d0' ? 1 : 0.4 }}"
              @click="changeThemeColor('#3184d0')"
            ></div>
            <div
              class="color-option"
              style="background-color: #f78803; opacity: {{ themeColor === '#f78803' ? 1 : 0.4 }}"
              @click="changeThemeColor('#f78803')"
            ></div>
            <div
              class="color-option"
              style="background-color: #e74c3c; opacity: {{ themeColor === '#e74c3c' ? 1 : 0.4 }}"
              @click="changeThemeColor('#e74c3c')"
            ></div>
            <div
              class="color-option"
              style="background-color: #27ae60; opacity: {{ themeColor === '#27ae60' ? 1 : 0.4 }}"
              @click="changeThemeColor('#27ae60')"
            ></div>
            <div
              class="color-option"
              style="background-color: #9b59b6; opacity: {{ themeColor === '#9b59b6' ? 1 : 0.4 }}"
              @click="changeThemeColor('#9b59b6')"
            ></div>
          </div>
        </div>
      </scroll>
    </div>
    <img
      if="{{ extend != 'true' && global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/del_rect.png"
      @click="deleteEvent"
    />
    <img
      elif="{{ extend != 'true' && global.screenShape != 'rect' }}"
      class="top"
      src="/common/del.png"
      @click="deleteEvent"
    />
    <img
      elif="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <img else class="top" src="/common/back.png" @click="routeBack" />
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/check_rect.png"
      @click="saveEvent"
    />
    <img else class="bottom" src="/common/check.png" @click="saveEvent" />
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"
import {showToast} from "@system.prompt"

export default {
  private: {
    event_name: "",
    extend: "true",
    date: "",
    on_index: true,
    IFStaringDay: false,
    themeColor: "#3184d0",
    callback_uri: "/pages/index",
    event_id: "0",
    time: "",
    pageVisible: false,
    contentVisible: false
  },

  routeBack() {
    if (router.getLength() > 1) {
      router.back({path: this.callback_uri})
    } else {
      router.replace({uri: this.callback_uri})
    }
  },

  onInit() {
    // 只用标量标记当前子页请求，不把编辑页对象存入全局。
    global.__daymatterEditSequence = (global.__daymatterEditSequence || 0) + 1
    this._editSessionId = String(global.__daymatterEditSequence)
    this._editRequestSequence = 0
    this._pendingField = ""
    this._pendingRequestId = ""
    this._destroyed = false
    this._saving = false
    if (this.date == "") {
      const _date = new Date()
      this.date = _date.getFullYear() + "-" + (_date.getMonth() + 1) + "-" + _date.getDate()
    }
  },

  onShow() {
    this.pageVisible = true
    this.contentVisible = true
    this.time = global.getTime()
    if (this._pendingField === "event_name") {
      if (global.__daymatterImeOwner === this._pendingRequestId) {
        const result = global.__imeResult
        this.clearImeResult()
        // 返回键取消时保留原名称，确认只更新草稿，不立即写盘。
        if (result && result.confirmed === true && typeof result.text === "string") {
          this.event_name = result.text
        }
      }
    } else if (this._pendingField === "date") {
      const result = global.__daymatterDateResult
      if (result && result.requestId === this._pendingRequestId) {
        if (typeof result.date === "string") this.date = result.date
        global.__daymatterDateResult = null
      }
    }
    this._pendingField = ""
    this._pendingRequestId = ""
  },

  onHide() {
    // 离开页面时移除跑马灯与表单节点，停止滚动；草稿数据保留在 this 中
    this.pageVisible = false
    this.contentVisible = false
  },

  onDestroy() {
    this._destroyed = true
    this.clearImeResult()
    const result = global.__daymatterDateResult
    if (result && result.requestId === this._pendingRequestId) {
      global.__daymatterDateResult = null
    }
    this._pendingField = ""
    this._pendingRequestId = ""
    this.event_name = ""
    this._saving = false
  },

  clearImeResult() {
    if (!this._pendingRequestId || global.__daymatterImeOwner !== this._pendingRequestId) return
    global.__imeText = ""
    global.__imeLabel = ""
    global.__imeResult = null
    global.__daymatterImeOwner = null
  },

  editEventName() {
    if (this._pendingField) return
    this._pendingField = "event_name"
    this._pendingRequestId = this._editSessionId + ":" + ++this._editRequestSequence
    global.__daymatterImeOwner = this._pendingRequestId
    global.__imeText = this.event_name
    global.__imeLabel = this.$t("eventName")
    global.__imeResult = null
    router.push({uri: "/pages/ime"})
  },

  editDate() {
    if (this._pendingField) return
    this._pendingField = "date"
    this._pendingRequestId = this._editSessionId + ":" + ++this._editRequestSequence
    global.__daymatterDateResult = null
    router.push({
      uri: "/pages/datepicker",
      params: {
        date: this.date,
        requestId: this._pendingRequestId
      }
    })
  },

  changeDisplayOnIndex() {
    if (this.on_index === "true") {
      this.on_index = true
    } else if (this.on_index === "false") {
      this.on_index = false
    }
    this.on_index = !this.on_index
  },

  changeDisplayIFStaringDay() {
    if (this.IFStaringDay === "true") {
      this.IFStaringDay = true
    } else if (this.IFStaringDay === "false") {
      this.IFStaringDay = false
    }
    this.IFStaringDay = !this.IFStaringDay
  },

  changeThemeColor(color) {
    this.themeColor = color
  },

  normalizeBoolean(value) {
    if (value === "true") return true
    if (value === "false") return false
    return value
  },

  showErrorToast(code) {
    showToast({message: this.$t("saveFail", {code: code})})
  },

  saveEvent() {
    if (this._saving) return
    if (this.event_name == "") {
      showToast({message: this.$t("eventNameRequired")})
      return
    }

    this._saving = true
    this.on_index = this.normalizeBoolean(this.on_index)
    this.IFStaringDay = this.normalizeBoolean(this.IFStaringDay)

    const event = {
      name: this.event_name,
      date: this.date,
      on_index: this.on_index,
      IFStaringDay: this.IFStaringDay,
      themeColor: this.themeColor
    }

    file.readText({
      uri: "internal://files/events.json",
      success: (data) => {
        if (this._destroyed) return
        let events
        try {
          events = JSON.parse(data.text)
        } catch (e) {
          events = []
        }
        if (!Array.isArray(events)) events = []
        if (this.extend == "true") {
          events.push(event)
        } else {
          events[Number(this.event_id)] = event
        }
        this.writeEvents(events)
      },
      fail: () => {
        if (this._destroyed) return
        // 文件不存在时，创建新数组
        this.writeEvents([event])
      }
    })
  },

  writeEvents(events) {
    file.writeText({
      uri: "internal://files/events.json",
      text: JSON.stringify(events),
      success: () => {
        if (this._destroyed) return
        if (this.on_index) {
          this.saveDateToFile()
        }
        showToast({message: this.$t("saveSuccess")})
        this.routeBack()
      },
      fail: (data, code) => {
        if (this._destroyed) return
        this._saving = false
        this.showErrorToast(code)
      }
    })
  },

  saveDateToFile() {
    file.writeText({
      uri: "internal://files/date.txt",
      text: `${this.event_name},${this.date},${this.IFStaringDay}`,
      success: () => {},
      fail: (data, code) => {
        if (this._destroyed) return
        this.showErrorToast(code)
      }
    })
  },

  deleteEvent() {
    if (this._saving) return
    this._saving = true
    file.readText({
      uri: "internal://files/events.json",
      success: (data) => {
        if (this._destroyed) return
        let events
        try {
          events = JSON.parse(data.text)
        } catch (e) {
          events = []
        }
        if (!Array.isArray(events)) events = []
        events.splice(Number(this.event_id), 1)
        file.writeText({
          uri: "internal://files/events.json",
          text: JSON.stringify(events),
          success: () => {
            if (this._destroyed) return
            showToast({message: this.$t("deleteSuccess")})
            this.routeBack()
          },
          fail: (data, code) => {
            if (this._destroyed) return
            this._saving = false
            this.showErrorToast(code)
          }
        })
      },
      fail: () => {
        if (this._destroyed) return
        // 文件不存在，直接返回
        this.routeBack()
      }
    })
  }
}
</script>

<style>
@import "../../common/app.css";

.new-page {
  flex-direction: column;
  align-items: center;
  color: white;
  background-color: black;
}

.padding {
  margin-top: 116px;
  margin-bottom: 86px;
}

.line {
  display: flex;
  flex-direction: column;
  justify-content: left;
  width: 90%;
}

text,
marquee {
  font-size: 24px;
  font-weight: bold;
}

.input-line {
  height: 48px;
  width: 100%;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 100%;
  margin-top: 4px;
}

.input-text {
  lines: 1;
  position: absolute;
  padding: 0 12px;
}

.button {
  width: 85%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.color-picker-container {
  width: 85%;
  align-items: center;
}

.color-picker {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
  margin-top: 8px;
  margin-bottom: 20px;
}

.color-option {
  width: 48px;
  height: 48px;
  border-radius: 100%;
  margin-bottom: 10px;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.box {
  position: relative;
  width: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

@media (device-type: band) and (shape: rect) {
  .line {
    width: 83%;
  }

  .button,
  .color-picker-container {
    width: 75%;
  }

  .color-picker-container {
    align-items: flex-start;
  }

  .button {
    flex-direction: row;
  }

  .padding {
    margin-top: 92px;
    margin-bottom: 16px;
  }

  .color-option {
    width: 42px;
    height: 42px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .line {
    width: 75%;
  }

  .button,
  .color-picker-container {
    width: 70%;
  }

  .button {
    flex-direction: row;
  }

  .color-picker-container {
    align-items: flex-start;
  }

  .padding {
    margin-top: 102px;
    margin-bottom: 32px;
  }

  .color-option {
    width: 48px;
    height: 48px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .padding {
    margin-top: 92px;
    margin-bottom: 84px;
  }

  .line {
    width: 70%;
  }

  .button,
  .color-picker-container {
    width: 65%;
  }

  .button {
    flex-direction: row;
  }

  .color-picker-container {
    align-items: flex-start;
  }

  .color-option {
    width: 48px;
    height: 48px;
  }
}
</style>
