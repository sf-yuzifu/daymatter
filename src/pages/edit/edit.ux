<template>
  <div class="new-page">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">
      {{ extend == "true" ? $t("addEvent") : $t("editEvent") }}
    </text>
    <div class="box padding" if="{{ contentVisible }}">
      <scroll id="edit-scroll" class="box" scroll-x="false" scroll-y="true" bounces="true">
        <div class="line button" if="{{ extend === 'true' }}">
          <div class="setting-content"><text class="setting-label">{{ $t("quickTemplate") }}</text></div>
          <picker class="unit-picker category-picker" type="text" range="{{ templateOptions }}" selected="{{ templateIndex }}" @change="onTemplateChange"></picker>
        </div>
        <div class="line field-card">
          <text class="field-label input-label">{{ $t("eventName") }}</text>
          <div class="input-line" @click="editEventName">
            <scroll class="input-scroll" scroll-x="true">
              <text class="input-text">
                {{ event_name }}
              </text>
            </scroll>
          </div>
        </div>
        <div class="line field-card">
          <text class="field-label input-label">{{ $t("targetDateLabel") }}</text>
          <div class="input-line" @click="editDate">
            <scroll class="input-scroll" scroll-x="true">
              <text class="input-text">{{ date }}</text>
            </scroll>
          </div>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee
              if="{{ global.isPillShaped && pageVisible }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("showOnHome") }}
            </marquee>
            <text class="setting-label" else>{{ $t("showOnHome") }}</text>
            <marquee
              class="setting-info"
              if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("showOnHomeInfo") }}
            </marquee>
          </div>
          <img
            if="{{ global.isPillShaped }}"
            style="height: 48px"
            src="/common/{{ on_index }}.png"
            @click="changeDisplayOnIndex"
          />
          <switch
            else
            class="setting-switch"
            checked="{{ on_index === true || on_index === 'true' }}"
            @change="onHomeChange"
          ></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee
              if="{{ global.isPillShaped && pageVisible }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("useAsWatchface") }}
            </marquee>
            <text class="setting-label" else>{{ $t("useAsWatchface") }}</text>
            <marquee
              class="setting-info"
              if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("useAsWatchfaceInfo") }}
            </marquee>
          </div>
          <img
            if="{{ global.isPillShaped }}"
            style="height: 48px"
            src="/common/{{ useWatchface }}.png"
            @click="changeUseWatchface"
          />
          <switch
            else
            class="setting-switch"
            checked="{{ useWatchface === true || useWatchface === 'true' }}"
            @change="onWatchfaceChange"
          ></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee
              if="{{ global.isPillShaped && pageVisible }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("includeStartDay") }}
            </marquee>
            <text class="setting-label" else>{{ $t("includeStartDay") }}</text>
            <marquee
              class="setting-info"
              if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("includeStartDayInfo") }}
            </marquee>
          </div>
          <img
            if="{{ global.isPillShaped }}"
            style="height: 48px"
            src="/common/{{ IFStaringDay }}.png"
            @click="changeDisplayIFStaringDay"
          />
          <switch
            else
            class="setting-switch"
            checked="{{ IFStaringDay === true || IFStaringDay === 'true' }}"
            @change="onStartDayChange"
          ></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <marquee
              if="{{ global.isPillShaped && pageVisible }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("annualRepeat") }}
            </marquee>
            <text class="setting-label" else>{{ $t("annualRepeat") }}</text>
            <marquee
              class="setting-info"
              if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("annualRepeatInfo") }}
            </marquee>
          </div>
          <div if="{{ global.isPillShaped }}">
            <img
              if="{{ repeat === 'yearly' }}"
              style="height: 48px"
              src="/common/true.png"
              @click="changeRepeat"
            />
            <img else style="height: 48px" src="/common/false.png" @click="changeRepeat" />
          </div>
          <switch
            else
            class="setting-switch"
            checked="{{ repeat === 'yearly' }}"
            @change="onRepeatChange"
          ></switch>
        </div>
        <div class="line button" style="margin-bottom: 8px">
          <div class="setting-content">
            <text class="setting-label">{{ $t("displayUnit") }}</text>
            <marquee
              class="setting-info"
              if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}"
              scrollamount="20"
              text-offset="20"
            >
              {{ $t("displayUnitInfo") }}
            </marquee>
          </div>
          <picker
            class="unit-picker"
            type="text"
            range="{{ unitOptions }}"
            selected="{{ unitKeys.indexOf(displayUnit) }}"
            @change="onUnitChange"
          ></picker>
        </div>
        <div class="line button">
          <div class="setting-content">
            <text class="setting-label">{{ $t("pinned") }}</text>
          </div>
          <img
            if="{{ global.isPillShaped }}"
            style="height: 48px"
            src="/common/{{ pinned }}.png"
            @click="changePinned"
          />
          <switch
            else
            class="setting-switch"
            checked="{{ pinned === true || pinned === 'true' }}"
            @change="onPinnedChange"
          ></switch>
        </div>
        <div class="line button">
          <div class="setting-content">
            <text class="setting-label">{{ $t("archived") }}</text>
          </div>
          <img
            if="{{ global.isPillShaped }}"
            style="height: 48px"
            src="/common/{{ archived }}.png"
            @click="changeArchived"
          />
          <switch
            else
            class="setting-switch"
            checked="{{ archived === true || archived === 'true' }}"
            @change="onArchivedChange"
          ></switch>
        </div>
        <div class="line button">
          <div class="setting-content">
            <text class="setting-label">{{ $t("category") }}</text>
          </div>
          <picker
            class="unit-picker category-picker"
            type="text"
            range="{{ categoryOptions }}"
            selected="{{ categoryKeys.indexOf(category) }}"
            @change="onCategoryChange"
          ></picker>
        </div>
        <div class="line field-card move-card" if="{{ extend !== 'true' }}">
          <div class="move-actions">
            <text class="move-button" @click="moveEvent('up')">{{ $t("moveUp") }}</text>
            <text class="move-button" @click="moveEvent('down')">{{ $t("moveDown") }}</text>
          </div>
          <text class="move-hint" if="{{ moveDirection }}">
            {{ $t(moveDirection === "up" ? "moveUp" : "moveDown") }} · {{ $t("saveToApply") }}
          </text>
        </div>
        <div class="line color-picker-container">
          <text class="field-label">{{ $t("themeColor") }}</text>
          <marquee
            class="setting-info"
            if="{{ pageVisible && (global.screenShape === 'rect' || global.screenShape === 'circle') }}"
            scrollamount="20"
            text-offset="20"
          >
            {{ $t("themeColorInfo") }}
          </marquee>
          <div class="color-picker">
            <div
              class="color-option"
              style="background-color: #3184d0; opacity: {{ themeColor === '#3184d0' ? 1 : 0.4 }}"
              @click="changeThemeColor('#3184d0')"
            ></div>
            <div
              class="color-option"
              style="background-color: #f78803; opacity: {{ themeColor === '#f78803' ? 1 : 0.4 }}"
              @click="changeThemeColor('#f78803')"
            ></div>
            <div
              class="color-option"
              style="background-color: #e74c3c; opacity: {{ themeColor === '#e74c3c' ? 1 : 0.4 }}"
              @click="changeThemeColor('#e74c3c')"
            ></div>
            <div
              class="color-option"
              style="background-color: #27ae60; opacity: {{ themeColor === '#27ae60' ? 1 : 0.4 }}"
              @click="changeThemeColor('#27ae60')"
            ></div>
            <div
              class="color-option"
              style="background-color: #9b59b6; opacity: {{ themeColor === '#9b59b6' ? 1 : 0.4 }}"
              @click="changeThemeColor('#9b59b6')"
            ></div>
          </div>
        </div>
        <div
          class="line delete-card"
          if="{{ global.screenShape === 'circle' && extend != 'true' && !deleteConfirmVisible }}"
          @click="confirmDeleteEvent"
        >
          <text class="delete-label">{{ $t("deleteEvent") }}</text>
        </div>
        <div
          class="line delete-confirm"
          if="{{ global.screenShape === 'circle' && extend != 'true' && deleteConfirmVisible }}"
        >
          <text class="delete-confirm-message">
            {{ $t("deleteEventConfirm", {name: event_name}) }}
          </text>
          <div class="delete-confirm-actions">
            <text class="delete-confirm-button" @click="cancelDeleteEvent">{{ $t("cancel") }}</text>
            <text class="delete-confirm-button delete-label" @click="deleteEvent">
              {{ $t("deleteEvent") }}
            </text>
          </div>
        </div>
      </scroll>
    </div>
    <img
      if="{{ extend != 'true' && global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/del_rect.png"
      @click="deleteEvent"
    />
    <img
      elif="{{ extend != 'true' && global.isPillShaped }}"
      class="top"
      src="/common/del.png"
      @click="deleteEvent"
    />
    <img
      elif="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <text elif="{{ global.screenShape === 'circle' }}" class="title" @click="routeBack">
      <span class="iconfont">&#xe685;</span>
      <span>{{ extend == "true" ? $t("addEvent") : $t("editEvent") }}</span>
    </text>
    <img else class="top" src="/common/back.png" @click="routeBack" />
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/check_rect.png"
      @click="saveEvent"
    />
    <img else class="bottom" src="/common/check.png" @click="saveEvent" />
  </div>
</template>

<script>
import router from "@system.router"
import {showToast} from "@system.prompt"

export default {
  private: {
    event_name: "",
    templateIndex: 0,
    templateOptions: [],
    extend: "true",
    date: "",
    on_index: true,
    IFStaringDay: false,
    repeat: "none",
    displayUnit: "days",
    pinned: false,
    archived: false,
    category: "uncategorized",
    moveDirection: "",
    categoryKeys: ["uncategorized", "birthday", "study", "life", "anniversary"],
    categoryOptions: [],
    unitKeys: ["days", "weeks", "months", "years"],
    unitOptions: [],
    useWatchface: false,
    themeColor: "#3184d0",
    callback_uri: "/pages/index",
    event_id: "0",
    time: "",
    pageVisible: false,
    contentVisible: false,
    deleteConfirmVisible: false
  },

  routeBack() {
    if (router.getLength() > 1) {
      router.back({path: this.callback_uri})
    } else {
      router.replace({uri: this.callback_uri})
    }
  },

  onInit() {
    this.templateOptions = ["templateNone", "templateBirthday", "templateExam", "templateAnniversary"].map(key => this.$t(key))
    this.unitOptions = this.unitKeys.map((unit) => this.$t(unit))
    this.pinned = this.normalizeBoolean(this.pinned)
    this.archived = this.normalizeBoolean(this.archived)
    this.categoryOptions = this.categoryKeys.map((key) =>
      this.$t(key === "anniversary" ? "categoryAnniversary" : key)
    )
    this.repeat = this.repeat === "yearly" ? "yearly" : "none"
    if (["days", "weeks", "months", "years"].indexOf(this.displayUnit) < 0)
      this.displayUnit = "days"
    // 只用标量标记当前子页请求，不把编辑页对象存入全局。
    global.__daymatterEditSequence = (global.__daymatterEditSequence || 0) + 1
    this._editSessionId = String(global.__daymatterEditSequence)
    this._editRequestSequence = 0
    this._pendingField = ""
    this._pendingRequestId = ""
    this._destroyed = false
    this._saving = false
    // 表盘主事件与「首页展示」相互独立：进入时的状态决定保存时是否需要切换
    this._wasWatchface = this.watchface === true || this.watchface === "true"
    this.useWatchface = this._wasWatchface
    this._primaryChange = false
    this._ticker = global.createMinuteTicker(() => this.handleMinuteTick())
    // 统一日期格式：旧数据 / 插件参数中的 YYYY-M-D 归一到 YYYY-MM-DD，非法值回退今天
    const normalizedDate = global.dateUtils.normalizeDate(this.date)
    if (normalizedDate) {
      this.date = normalizedDate
    } else {
      const today = global.dateUtils.todayParts()
      this.date = global.dateUtils.formatDate(today.year, today.month, today.day)
    }
  },

  onShow() {
    this.pageVisible = true
    this.contentVisible = true
    this.time = global.getTime()
    if (this._pendingField === "event_name") {
      if (global.__daymatterImeOwner === this._pendingRequestId) {
        const result = global.__imeResult
        this.clearImeResult()
        // 返回键取消时保留原名称，确认只更新草稿，不立即写盘。
        if (result && result.confirmed === true && typeof result.text === "string") {
          this.event_name = result.text
        }
      }
    } else if (this._pendingField === "date") {
      const result = global.__daymatterDateResult
      if (result && result.requestId === this._pendingRequestId) {
        const normalized = global.dateUtils.normalizeDate(result.date)
        if (normalized) this.date = normalized
        global.__daymatterDateResult = null
      }
    }
    this._pendingField = ""
    this._pendingRequestId = ""
    this._ticker.start()
  },

  onTemplateChange(event) {
    if (this.extend !== "true" || this._saving) return
    const index = this.templateOptions.indexOf(event.newValue)
    if (![1, 2, 3].includes(index)) { this.templateIndex = 0; return }
    this.templateIndex = index
    if (!this.event_name || this.templateOptions.slice(1).includes(this.event_name))
      this.event_name = this.$t(["", "templateBirthday", "templateExam", "templateAnniversary"][index])
    this.category = ["", "birthday", "study", "anniversary"][index]
    this.repeat = index === 2 ? "none" : "yearly"
    this.displayUnit = "days"
  },

  handleMinuteTick() {
    if (this._destroyed) return
    // 编辑页只显示当前时间，目标日期草稿不随时钟变化
    this.time = global.getTime()
  },

  onHide() {
    clearTimeout(this._deleteScrollTimer)
    // 离开页面时移除跑马灯与表单节点，停止滚动与分钟时钟；草稿数据保留在 this 中
    this.pageVisible = false
    this.contentVisible = false
    this._ticker.stop()
  },

  onDestroy() {
    clearTimeout(this._deleteScrollTimer)
    this._destroyed = true
    this._ticker.stop()
    this.clearImeResult()
    const result = global.__daymatterDateResult
    if (result && result.requestId === this._pendingRequestId) {
      global.__daymatterDateResult = null
    }
    this._pendingField = ""
    this._pendingRequestId = ""
    this.event_name = ""
    this._saving = false
  },

  clearImeResult() {
    if (!this._pendingRequestId || global.__daymatterImeOwner !== this._pendingRequestId) return
    global.__imeText = ""
    global.__imeLabel = ""
    global.__imeResult = null
    global.__daymatterImeOwner = null
  },

  editEventName() {
    if (this._pendingField) return
    this._pendingField = "event_name"
    this._pendingRequestId = this._editSessionId + ":" + ++this._editRequestSequence
    global.__daymatterImeOwner = this._pendingRequestId
    global.__imeText = this.event_name
    global.__imeLabel = this.$t("eventName")
    global.__imeResult = null
    router.push({uri: "/pages/ime"})
  },

  editDate() {
    if (this._pendingField) return
    this._pendingField = "date"
    this._pendingRequestId = this._editSessionId + ":" + ++this._editRequestSequence
    global.__daymatterDateResult = null
    router.push({
      uri: "/pages/datepicker",
      params: {
        date: this.date,
        requestId: this._pendingRequestId
      }
    })
  },

  changeDisplayOnIndex() {
    if (this.on_index === "true") {
      this.on_index = true
    } else if (this.on_index === "false") {
      this.on_index = false
    }
    this.on_index = !this.on_index
  },

  changeDisplayIFStaringDay() {
    if (this.IFStaringDay === "true") {
      this.IFStaringDay = true
    } else if (this.IFStaringDay === "false") {
      this.IFStaringDay = false
    }
    this.IFStaringDay = !this.IFStaringDay
  },

  changeUseWatchface() {
    if (this.useWatchface === "true") {
      this.useWatchface = true
    } else if (this.useWatchface === "false") {
      this.useWatchface = false
    }
    this.useWatchface = !this.useWatchface
  },

  changeThemeColor(color) {
    this.themeColor = color
  },

  changePinned() {
    this.pinned = !this.normalizeBoolean(this.pinned)
  },
  onPinnedChange(event) {
    this.pinned = event.checked
  },
  onArchivedChange(event) {
    this.archived = event.checked
    if (this.archived) this.useWatchface = false
  },
  onCategoryChange(event) {
    const index = this.categoryOptions.indexOf(event.newValue)
    if (index >= 0) this.category = this.categoryKeys[index]
  },
  changeArchived() {
    this.archived = !this.normalizeBoolean(this.archived)
    if (this.archived) this.useWatchface = false
  },
  changeCategory() {
    const categories = global.eventOrder.CATEGORIES
    this.category = categories[(categories.indexOf(this.category) + 1) % categories.length]
  },
  moveEvent(direction) {
    if (!this._saving) this.moveDirection = direction
  },

  onHomeChange(event) {
    this.on_index = event.checked
  },

  onWatchfaceChange(event) {
    this.useWatchface = event.checked
  },

  onStartDayChange(event) {
    this.IFStaringDay = event.checked
  },

  onRepeatChange(event) {
    this.repeat = event.checked ? "yearly" : "none"
  },

  changeRepeat() {
    this.repeat = this.repeat === "yearly" ? "none" : "yearly"
  },

  changeUnit() {
    const units = ["days", "weeks", "months", "years"]
    this.displayUnit = units[(units.indexOf(this.displayUnit) + 1) % units.length]
  },

  normalizeBoolean(value) {
    if (value === "true") return true
    if (value === "false") return false
    return value
  },

  onUnitChange(event) {
    const index = this.unitOptions.indexOf(event.newValue)
    if (index >= 0) this.displayUnit = this.unitKeys[index]
  },

  showErrorToast(code) {
    showToast({message: this.$t("saveFail", {code: code})})
  },

  saveEvent() {
    if (this._saving) return
    if (this.event_name == "") {
      showToast({message: this.$t("eventNameRequired")})
      return
    }

    // 只接受真实日历日期，按统一格式写入；非法日期不保存，避免写入不存在日期
    const normalizedDate = global.dateUtils.normalizeDate(this.date)
    if (!normalizedDate) {
      showToast({message: this.$t("dateInvalid")})
      return
    }
    this.date = normalizedDate

    this._saving = true
    const payload = {
      name: this.event_name,
      repeat: this.repeat,
      displayUnit: this.displayUnit,
      pinned: this.normalizeBoolean(this.pinned),
      archived: this.normalizeBoolean(this.archived),
      category: this.category,
      date: this.date,
      on_index: this.normalizeBoolean(this.on_index),
      IFStaringDay: this.normalizeBoolean(this.IFStaringDay),
      themeColor: this.themeColor
    }

    // 页面收到的「当前是否表盘事件」与开关最终值不一致才需要切换主事件
    if (this.moveDirection && this.extend !== "true") payload.moveDirection = this.moveDirection
    const wantedWatchface =
      !payload.archived && (this.useWatchface === true || this.useWatchface === "true")
    this._primaryChange = !payload.archived && wantedWatchface !== this._wasWatchface

    const finish = (error) => {
      if (this._destroyed) return
      if (error) {
        if (error.code === "WATCHFACE_FAIL") {
          // D-20 分项结果：事件数据已提交，仅表盘文件失败；离开页面避免重复新增
          showToast({message: this.$t("watchfaceSyncFail"), duration: 2000})
          this.routeBack()
          return
        }
        // 保存失败保留当前草稿与页面，不虚报成功（D-16）
        this._saving = false
        this.showEventError(error)
        return
      }
      showToast({message: this.$t("saveSuccess")})
      this.routeBack()
    }

    const onStored = (error, result) => {
      if (error) {
        finish(error)
        return
      }
      const id = this.extend === "true" ? result.event.id : String(this.event_id)
      if (!this._primaryChange) return finish(null)
      global.eventStore.setPrimary(wantedWatchface ? id : "", finish)
    }

    if (this.extend === "true") {
      global.eventStore.add(payload, onStored)
    } else {
      global.eventStore.update(String(this.event_id), payload, onStored)
    }
  },

  showEventError(error) {
    const code = error && error.code
    if (code === "NAME_REQUIRED") {
      showToast({message: this.$t("eventNameRequired")})
      return
    }
    if (code === "NAME_TOO_LONG" || code === "NAME_INVALID") {
      showToast({
        message: this.$t(code === "NAME_TOO_LONG" ? "eventNameTooLong" : "eventNameInvalid")
      })
      return
    }
    if (code === "DATE_INVALID") {
      showToast({message: this.$t("dateInvalid")})
      return
    }
    if (code === "EVENT_LIMIT") {
      showToast({message: this.$t("tooManyEvents")})
      return
    }
    if (code === "NOT_FOUND") {
      showToast({message: this.$t("eventNotFound")})
      return
    }
    if (
      code === "INVALID_BOOLEAN" ||
      code === "INVALID_REPEAT" ||
      code === "INVALID_UNIT" ||
      code === "INVALID_CATEGORY" ||
      code === "INVALID_ORDER" ||
      code === "INVALID_MOVE" ||
      code === "ARCHIVED_PRIMARY" ||
      code === "INVALID_COLOR" ||
      code === "INVALID_EVENT"
    ) {
      showToast({message: this.$t("invalidEvent")})
      return
    }
    const causeCode = error && error.cause ? error.cause.code : code
    this.showErrorToast(causeCode)
  },

  confirmDeleteEvent() {
    if (this._saving) return
    this.deleteConfirmVisible = true
    clearTimeout(this._deleteScrollTimer)
    this._deleteScrollTimer = setTimeout(() => {
      if (this._destroyed || !this.pageVisible || !this.deleteConfirmVisible) return
      const scroll = this.$element("edit-scroll")
      if (!scroll || typeof scroll.getScrollRect !== "function") return
      scroll.getScrollRect({
        success: ({height}) => {
          if (this._destroyed || !this.pageVisible || !this.deleteConfirmVisible) return
          scroll.scrollTo({top: height, behavior: "smooth"})
        }
      })
    }, 50)
  },

  cancelDeleteEvent() {
    clearTimeout(this._deleteScrollTimer)
    if (!this._saving) this.deleteConfirmVisible = false
  },

  deleteEvent() {
    if (this._saving) return
    this._saving = true
    global.eventStore.remove(String(this.event_id), (error) => {
      if (this._destroyed) return
      if (error) {
        if (error.code === "WATCHFACE_FAIL") {
          // 事件已删除，仅表盘文件失败：报告分项结果后离开
          showToast({message: this.$t("watchfaceSyncFail"), duration: 2000})
          this.routeBack()
          return
        }
        this._saving = false
        this.showEventError(error)
        return
      }
      showToast({message: this.$t("deleteSuccess")})
      this.routeBack()
    })
  }
}
</script>

