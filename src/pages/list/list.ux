  }
}

@media (device-type: watch) and (shape: circle) {
  .event-item {
    height: 88px;
  }

  .countdown-card {
    height: 78px;
    margin-bottom: 0;
  }

  .card-header {
    width: 70%;
  }

  .countdown-name {
