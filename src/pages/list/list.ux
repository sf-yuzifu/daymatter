<template>
  <div class="list-page">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">
      {{ loadState === 'loading' && !hasSnapshot || loadState === 'error' && !hasSnapshot ? $t('eventListTitle') : $t("eventCount", {count: count}) }}
    </text>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top leftButton"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <text @click="routeBack" class="title" elif="{{ global.screenShape == 'circle' }}">
      <span class="iconfont">&#xe685;</span>
      <span>{{ !hasSnapshot ? $t('eventListTitle') : $t("eventCount", {count: count}) }}</span>
    </text>
    <img else class="top" src="/common/back.png" @click="routeBack" />
    <text class="count" if="{{ global.isPillShaped }}">{{ !hasSnapshot ? $t('eventListTitle') : $t("eventCount", {count: count}) }}</text>
    <div class="box">
      <div class="filter-panel" if="{{ contentVisible }}">
        <div class="filter-header" @click="toggleSettings">
          <marquee class="filter-summary" scrollamount="20" text-offset="20">
            {{ filterSummary }}
          </marquee>
          <text class="filter-arrow iconfont" if="{{ settingsExpanded }}">&#xe686;</text>
          <text class="filter-arrow iconfont" else>&#xe685;</text>
        </div>
        <div class="filter-body" if="{{ settingsExpanded }}">
          <div class="filter-row">
            <text class="filter-label">{{ $t("sortModeLabel") }}</text>
            <picker class="filter-picker" type="text" range="{{ sortOptions }}" selected="{{ sortIndex }}" @change="onSortSelect"></picker>
          </div>
          <div class="filter-row">
            <text class="filter-label">{{ $t("category") }}</text>
            <picker class="filter-picker" type="text" range="{{ categoryOptions }}" selected="{{ categoryIndex }}" @change="onCategorySelect"></picker>
          </div>
          <div class="filter-row">
            <text class="filter-label">{{ $t("displayScope") }}</text>
            <picker class="filter-picker" type="text" range="{{ scopeOptions }}" selected="{{ scopeIndex }}" @change="onScopeSelect"></picker>
          </div>
          <text class="state-action" if="{{ filtersActive }}" @click="resetFilters">{{ $t('resetFilters') }}</text>
        </div>
      </div>
      <div class="list-state" if="{{ contentVisible && loadState === 'loading' }}"><text class="state-text">{{ $t('eventsLoading') }}</text></div>
      <div class="list-state" elif="{{ contentVisible && loadState === 'error' }}">
        <text class="state-text">{{ $t(hasSnapshot ? 'eventsRefreshFail' : 'eventsLoadFail') }}</text>
        <text class="state-action" @click="loadList">{{ $t('retryLoad') }}</text>
      </div>
      <div class="list-state" elif="{{ contentVisible && hasSnapshot && count === 0 }}">
        <text class="state-text">{{ $t(emptyStore ? 'noEventsYet' : 'noMatchingEvents') }}</text>
        <text class="state-action" if="{{ filtersActive }}" @click="resetFilters">{{ $t('resetFilters') }}</text>
      </div>
      <list class="event-list" bounces="true" if="{{ contentVisible && hasSnapshot && count > 0 }}">
        <list-item
          for="{{ events }}"
          type="event"
          class="event-item"
          @click="routeEditEvent($item.storageIndex)"
        >
          <div class="countdown-card">
            <div
              class="{{ $item.statusText ? 'card-header' : 'card-header card-header-centered' }}"
              style="background-color: {{ global.adjustThemeColor($item.themeColor, $item.already) }}"
            >
              <div class="name-row">
                <marquee
                  class="{{ $item.watchface && !$item.statusText ? 'countdown-name countdown-name-with-icon' : 'countdown-name' }}"
                  scrollamount="20"
                  text-offset="20"
                >
                  {{ $item.name }}
                </marquee>
                <div class="watchface-icon" if="{{ $item.watchface && !$item.statusText }}">
                  <div class="watchface-strap"></div>
                  <div class="watchface-dial"></div>
                  <div class="watchface-strap"></div>
                </div>
              </div>
              <div class="status-row" if="{{ $item.statusText }}">
                <text class="countdown-status">{{ $item.statusText }}</text>
                <div class="watchface-icon" if="{{ $item.watchface }}">
                  <div class="watchface-strap"></div>
                  <div class="watchface-dial"></div>
                  <div class="watchface-strap"></div>
                </div>
              </div>
            </div>
            <div class="card-body">
              <text class="countdown-days" style="font-size: {{ $item.font_size }}">
                {{ $item.days }}
              </text>
            </div>
          </div>
        </list-item>
        <list-item type="pagination" class="pagination-item" if="{{ totalPages > 1 }}">
          <div class="pagination-controls">
            <div
              class="{{ page > 1 ? 'pagination-button' : 'pagination-button-disabled' }}"
              @click="changePage(page - 1)"
            >
              <text class="{{ page > 1 ? 'text-normal' : 'text-disabled' }}">
                {{ $t("prevPage") }}
              </text>
            </div>
            <text class="page-indicator">
              {{ $t("pageIndicator", {page: page, total: totalPages}) }}
            </text>
            <div
              class="{{ page < totalPages ? 'pagination-button' : 'pagination-button-disabled' }}"
              @click="changePage(page + 1)"
            >
              <text class="{{ page < totalPages ? 'text-normal' : 'text-disabled' }}">
                {{ $t("nextPage") }}
              </text>
            </div>
          </div>
        </list-item>
      </list>
    </div>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="top rightButton"
      src="/common/add_rect.png"
      @click="routeAdd"
    />
    <img else class="bottom" src="/common/add.png" @click="routeAdd" />
  </div>
</template>

<script>
import router from "@system.router"
import {showToast} from "@system.prompt"

function getExtraFontSize() {
  const shape = global.screenShape
  return shape === "rect" || shape === "circle" ? 8 : 0
}

function calculateListFontSize(days, todayStr) {
  if (days === todayStr) return 26
  const len = String(days).length
  if (len < 3) return 30
  if (len === 3) return 28
  return 20
}

const PAGE_SIZE = 10

let pendingListPage = 0

export default {
  private: {
    count: 0,
    events: [],
    time: "",
    page: 1,
    totalPages: 1,
    contentVisible: false,
    sortMode: "created",
    categoryFilter: "all",
    archiveFilter: false,
    periodFilter: "all",
    filterSummary: "",
    settingsExpanded: false,
    draftSort: "created",
    draftCategory: "all",
    draftArchived: false,
    sortOptions: [], categoryOptions: [], scopeOptions: [],
    sortIndex: 0, categoryIndex: 0, scopeIndex: 0,
    filtersActive: false, hasSnapshot: false, loadState: "loading", emptyStore: true
  },

  onInit() {
    // 原始事件快照只保存在非响应式属性，展示数组只保留当前页
    this._allEvents = []
    this._primaryId = ""
    this._destroyed = false
    this._loadGeneration = 0
    this._categories = ["all"].concat(global.eventOrder.CATEGORIES)
    this._scopes = ["all", "archived", "today", "upcoming"]
    this.sortOptions = global.eventOrder.MODES.map(key => this.$t(key))
    this.categoryOptions = this._categories.map(key => this.$t(key === "anniversary" ? "categoryAnniversary" : key))
    this.scopeOptions = ["activeEvents", "archived", "todayEvents", "upcomingEvents"].map(key => this.$t(key))
    this._ticker = global.createMinuteTicker((dateChanged) => this.handleMinuteTick(dateChanged))
  },

  onBackPress() {
    if (this.settingsExpanded) {
      this.toggleSettings()
      return true
    }
    this.routeBack()
    return true
  },

  routeBack() {
    if (router.getLength() > 1) {
      router.back({path: "/pages/index"})
    } else {
      router.replace({uri: "/pages/index"})
    }
  },

  formatEvent(event, storageIndex, cachedStatus) {
    const recurringStatus =
      cachedStatus === undefined ? global.dateUtils.getRecurringStatus(event) : cachedStatus
    const status = recurringStatus || global.dateUtils.TODAY_STATUS
    let days,
      statusText = "",
      already = true

    if (status.state === "past") {
      statusText = this.$t("already").trim()
      days = String(status.days)
    } else if (status.state === "today") {
      days = this.$t("today")
    } else {
      statusText = this.$t("remaining").trim()
      days = String(status.days)
      already = false
    }

    // 名称保持独立；周年在状态之前，表盘标记不再拼进名称。
    const watchface = event.id === this._primaryId
    if (event.calendar === "lunar" && !recurringStatus) days = "--"
    if (event.repeat === "yearly" && status.anniversary !== null)
      statusText =
        this.$t("anniversary", {count: status.anniversary}) + (statusText ? " · " + statusText : "")

    const font_size = calculateListFontSize(days, this.$t("today")) + getExtraFontSize()

    return {
      name: event.name,
      id: event.id,
      statusText,
      watchface,
      date: event.date,
      days,
      already,
      themeColor: event.themeColor,
      on_index: event.on_index,
      IFStaringDay: event.IFStaringDay || false,
      font_size,
      storageIndex
    }
  },

  onShow() {
    this.contentVisible = true
    this.time = global.getTime()
    this.loadList()
    this._ticker.start()
  },

  loadList() {
    const generation = ++this._loadGeneration
    const finishRead = global.startPerfTrace && global.startPerfTrace("list.read")
    this.loadState = "loading"
    // 从编辑 / 新增返回时恢复原页；列表销毁重建也由模块级变量兜底
    const restorePage = pendingListPage
    pendingListPage = 0
    global.eventStore.read((error, result) => {
      if (finishRead) finishRead({ok: !error})
      if (this._destroyed || !this.contentVisible || generation !== this._loadGeneration) return
      if (error) {
        this.loadState = "error"
        return
      }
      this.sortMode = result.sortMode || "created"
      this._allEvents = result.events
      this._primaryId = result.primaryId || ""
      this.hasSnapshot = true
      this.loadState = "ready"
      this.emptyStore = result.events.length === 0
      this.showPage(restorePage > 0 ? restorePage : this.page)
    })
  },

  handleMinuteTick(dateChanged) {
    if (this._destroyed || !this.contentVisible) return
    this.time = global.getTime()
    if (dateChanged) {
      // 跨午夜后当前页天数需要重新计算
      this.loadList()
    }
  },

  onHide() {
    this._loadGeneration++
    this.hasSnapshot = false
    this.settingsExpanded = false
    // 隐藏时释放列表节点与展示数据，页码 / 原始下标在重新显示时重新校验
    this.contentVisible = false
    this._allEvents = []
    this._primaryId = ""
    this.events = []
    this._ticker.stop()
  },

  onDestroy() {
    this._loadGeneration++
    this._destroyed = true
    this._ticker.stop()
    this._allEvents = []
    this._primaryId = ""
    this.events = []
    if (typeof global.tryRunGC === "function") global.tryRunGC()
  },

  showPage(targetPage) {
    this.sortIndex = global.eventOrder.MODES.indexOf(this.sortMode)
    this.categoryIndex = this._categories.indexOf(this.categoryFilter)
    this.scopeIndex = this._scopes.indexOf(this.archiveFilter ? "archived" : this.periodFilter)
    this.filtersActive = this.categoryFilter !== "all" || this.archiveFilter || this.periodFilter !== "all"
    this.filterSummary = this.sortOptions[this.sortIndex] + " · " + this.categoryOptions[this.categoryIndex] + " · " + this.scopeOptions[this.scopeIndex]
    const refresh = global.eventOrder.createRefresh(global.dateUtils)
    const finishOrder = global.startPerfTrace && global.startPerfTrace("list.selectSort")
    const ordered = global.eventOrder.select(this._allEvents, this.sortMode, global.dateUtils, {
      archived: this.archiveFilter,
      category: this.categoryFilter,
      period: this.periodFilter,
      refresh
    })
    if (finishOrder) finishOrder({count: ordered.length})
    const total = ordered.length
    const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE))
    let page = targetPage > 0 ? targetPage : 1
    if (page > totalPages) page = totalPages
    this.totalPages = totalPages
    this.count = total
    this.page = page
    const start = (page - 1) * PAGE_SIZE
    const end = Math.min(start + PAGE_SIZE, total)
    const pageEvents = []
    const finishFormat = global.startPerfTrace && global.startPerfTrace("list.formatPage")
    for (let i = start; i < end; i++) {
      pageEvents.push(
        this.formatEvent(
          ordered[i],
          this._allEvents.findIndex((e) => e.id === ordered[i].id),
          refresh.getStatus(ordered[i])
        )
      )
    }
    this.events = pageEvents
    if (finishFormat) finishFormat({count: pageEvents.length})
    const finishUi = global.startPerfTrace && global.startPerfTrace("list.nextTick")
    const generation = this._loadGeneration
    if (finishUi && typeof this.$nextTick === "function") this.$nextTick(() => {
      if (!this._destroyed && this.contentVisible && generation === this._loadGeneration) finishUi()
    })
  },

  changePage(targetPage) {
    if (targetPage < 1 || targetPage > this.totalPages || targetPage === this.page) return
    this.showPage(targetPage)
  },

  toggleSettings() {
    if (this._savingSettings) return
    this.settingsExpanded = !this.settingsExpanded
    if (this.settingsExpanded) {
      this.draftSort = this.sortMode
      this.draftCategory = this.categoryFilter
      this.draftArchived = this.archiveFilter
    }
  },

  onSortSelect(event) {
    const index = this.sortOptions.indexOf(event.newValue)
    if (index >= 0) this.saveSortMode(global.eventOrder.MODES[index])
  },
  onCategorySelect(event) {
    if (this._savingSettings) return
    const index = this.categoryOptions.indexOf(event.newValue)
    if (index < 0) return
    this.categoryFilter = this.draftCategory = this._categories[index]
    this.showPage(1)
  },
  onScopeSelect(event) {
    if (this._savingSettings) return
    const index = this.scopeOptions.indexOf(event.newValue)
    if (index < 0) return
    this.archiveFilter = this.draftArchived = index === 1
    this.periodFilter = index === 1 ? "all" : this._scopes[index]
    this.showPage(1)
  },
  resetFilters() {
    if (this._savingSettings) return
    this.categoryFilter = this.draftCategory = "all"
    this.archiveFilter = this.draftArchived = false
    this.periodFilter = "all"
    this.showPage(1)
  },
  cycleDraftSort() {
    const modes = global.eventOrder.MODES
    this.saveSortMode(modes[(modes.indexOf(this.sortMode) + 1) % modes.length])
  },
  saveSortMode(mode) {
    if (this._savingSettings) return
    if (mode === this.sortMode || this.loadState !== "ready") return
    this._savingSettings = true
    global.eventStore.setSortMode(mode, (error) => {
      this._savingSettings = false
      if (this._destroyed) return
      if (error && error.code !== "WATCHFACE_FAIL") {
        this.sortIndex = global.eventOrder.MODES.indexOf(this.sortMode)
        showToast({message: this.$t("saveFail", {code: error.code})})
        return
      }
      this.sortMode = mode
      this.draftSort = mode
      if (this.contentVisible) this.showPage(1)
      if (error) showToast({message: this.$t("watchfaceSyncFail")})
    })
  },
  cycleDraftCategory() {
    if (this._savingSettings) return
    const categories = ["all"].concat(global.eventOrder.CATEGORIES)
    this.draftCategory =
      categories[(categories.indexOf(this.draftCategory) + 1) % categories.length]
    this.categoryFilter = this.draftCategory
    this.showPage(1)
  },
  cycleDraftScope() {
    if (this._savingSettings) return
    const scopes = ["all", "archived", "today", "upcoming"]
    const current = this.archiveFilter ? "archived" : this.periodFilter
    const next = scopes[(scopes.indexOf(current) + 1) % scopes.length]
    this.periodFilter = next === "archived" ? "all" : next
    this.draftArchived = next === "archived"
    this.archiveFilter = this.draftArchived
    this.showPage(1)
  },

  changeCategory() {
    const categories = ["all"].concat(global.eventOrder.CATEGORIES)
    this.categoryFilter =
      categories[(categories.indexOf(this.categoryFilter) + 1) % categories.length]
    this.showPage(1)
  },

  changeArchive() {
    this.archiveFilter = !this.archiveFilter
    this.showPage(1)
  },

  onRefresh() {
    router.clear()
  },

  routeEditEvent(storageIndex) {
    if (this.loadState !== "ready") return
    const event = this._allEvents[storageIndex]
    if (!event) return
    pendingListPage = this.page
    router.push({
      uri: "/pages/edit",
      params: {
        extend: "false",
        event_id: event.id !== undefined ? String(event.id) : String(storageIndex),
        event_name: event.name,
        date: event.date,
        calendar: event.calendar || "solar",
        lunarDate: JSON.stringify(event.lunarDate || null),
        repeat: event.repeat || "none",
        displayUnit: event.displayUnit || "days",
        pinned: event.pinned,
        archived: event.archived,
        category: event.category || "uncategorized",
        on_index: event.on_index,
        themeColor: event.themeColor,
        IFStaringDay: event.IFStaringDay || false,
        watchface: event.id === this._primaryId ? "true" : "false",
        callback_uri: "/pages/list"
      }
    })
  },

  routeAdd() {
    pendingListPage = this.page
    router.push({
      uri: "/pages/edit",
      params: {
        extend: "true",
        event_id: this.count,
        // 尚无主事件时新增的第一个事件默认作为表盘事件，衔接旧行为
        watchface: this._primaryId ? "false" : "true",
        callback_uri: "/pages/list"
      }
    })
  }
}
</script>

<style>
@import "../../common/app.css";
.filter-picker {
  flex: 1;
  min-width: 0px;
  height: 36px;
  font-size: 22px;
  color: #eeeeee;
  selected-color: #eeeeee;
  background-color: #363636;
  border-radius: 10px;
}
.list-state {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 12px 0;
  flex-shrink: 0;
}
.state-text {
  width: 100%;
  font-size: 22px;
  color: #aaaaaa;
  text-align: center;
}
.state-action {
  width: 100%;
  height: 40px;
  font-size: 22px;
  color: #70b7ff;
  text-align: center;
  margin-top: 6px;
  flex-shrink: 0;
}
@media (shape: pill-shaped) {
  .filter-picker {
    width: 100%;
    height: 30px;
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 0;
  }
}
.filter-item {
  width: 100%;
}
.filter-panel {
  width: 100%;
  padding: 0 12px;
  margin-bottom: 8px;
  flex-shrink: 0;
  flex-direction: column;
  border: 3px solid rgba(255, 255, 255, 0.06);
  background-color: #262626;
  border-radius: 14px;
}
.filter-header {
  width: 100%;
  height: 44px;
  align-items: center;
  flex-shrink: 0;
}
.filter-summary {
  flex: 1;
  height: 28px;
  font-size: 22px;
  font-weight: bold;
  color: #eeeeee;
  lines: 1;
  text-overflow: ellipsis;
}
.filter-arrow {
  width: 20px;
  height: 24px;
  font-size: 20px;
  color: #aaaaaa;
  text-align: center;
  flex-shrink: 0;
}
.filter-body {
  width: 100%;
  flex-direction: column;
}
.filter-row {
  width: 100%;
  height: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.filter-label {
  width: 92px;
  font-size: 22px;
  font-weight: bold;
  color: #999999;
  flex-shrink: 0;
  margin-right: 6px;
}
.filter-value {
  flex: 1;
  height: 28px;
  font-size: 22px;
  font-weight: bold;
  color: #eeeeee;
  text-align: right;
  lines: 1;
  text-overflow: ellipsis;
}

@media (shape: pill-shaped) {
  .filter-panel {
    padding: 0 10px;
    border-radius: 14px;
  }
  .filter-header {
    height: 40px;
  }
  .filter-summary {
    font-size: 22px;
    text-align: center;
  }
  .filter-header {
    position: relative;
    justify-content: center;
  }
  .filter-arrow {
    position: absolute;
    right: 0px;
  }
  .filter-row {
    height: 64px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .filter-label,
  .filter-value {
    width: 100%;
    height: 28px;
    font-size: 22px;
    text-align: center;
    margin-right: 0px;
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 0;
  }
}

@media (shape: rect) {
  .filter-panel {
    padding: 0 16px;
    border-radius: 14px;
  }
  .filter-header {
    height: 48px;
  }
  .filter-summary {
    font-size: 24px;
    height: 32px;
  }
  .filter-row {
    height: 48px;
  }
  .filter-label {
    width: 100px;
  }
  .filter-label,
  .filter-value {
    font-size: 24px;
    height: 32px;
  }
}

@media (shape: circle) {
  .filter-panel {
    padding: 0 16px;
    border-radius: 14px;
  }
  .filter-header {
    height: 48px;
  }
  .filter-summary {
    font-size: 24px;
    height: 32px;
  }
  .filter-row {
    height: 48px;
  }
  .filter-label {
    width: 100px;
  }
  .filter-label,
  .filter-value {
    font-size: 24px;
    height: 32px;
  }
}

.list-page {
  flex-direction: column;
  align-items: center;
  color: white;
  background-color: black;
}

.box {
  position: relative;
  flex: 1;
  width: 90%;
  margin-bottom: 86px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.event-list {
  flex: 1;
  width: 100%;
}

.event-item {
  width: 100%;
  height: 74px;
}

.countdown-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 66px;
  border-radius: 14px;
  margin-bottom: 0;
  overflow: hidden;
  background-color: white;
}

.card-header {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 65%;
  height: 100%;
  padding: 6px 6px;
}

.name-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.card-header-centered {
  justify-content: center;
}

.status-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.watchface-icon {
  width: 14px;
  height: 20px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 4px;
  flex-shrink: 0;
}

.watchface-strap {
  width: 6px;
  height: 3px;
  background-color: white;
  flex-shrink: 0;
}

.watchface-dial {
  width: 12px;
  height: 12px;
  border: 2px solid white;
  border-radius: 3px;
  flex-shrink: 0;
}

.countdown-status {
  flex-shrink: 1;
  font-size: 16px;
  font-weight: bold;
  color: white;
  lines: 1;
  text-overflow: ellipsis;
  flex-shrink: 0;
}

.countdown-name {
