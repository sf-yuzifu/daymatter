  position: relative;
  flex: 1;
  width: 90%;
  margin-bottom: 86px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

scroll {
  flex: 1;
  width: 100%;
  align-items: flex-start;
  flex-direction: column;
}

