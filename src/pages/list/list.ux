  flex-direction: column;
  background-color: #262626;
  border-radius: 14px;
}
.filter-header {
  width: 100%;
  height: 44px;
  align-items: center;
  flex-shrink: 0;
}
.filter-summary {
  flex: 1;
  height: 28px;
  font-size: 22px;
  font-weight: bold;
  color: #eeeeee;
  lines: 1;
  text-overflow: ellipsis;
}
.filter-arrow {
  width: 20px;
  height: 24px;
  font-size: 20px;
  color: #aaaaaa;
  text-align: center;
  flex-shrink: 0;
}
.filter-body {
  width: 100%;
  flex-direction: column;
}
.filter-row {
  width: 100%;
  height: 42px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.filter-label {
  font-size: 22px;
  font-weight: bold;
  color: #999999;
  flex-shrink: 0;
  margin-right: 6px;
}
.filter-value {
  flex: 1;
  height: 28px;
  font-size: 22px;
  font-weight: bold;
  color: #eeeeee;
  text-align: right;
  lines: 1;
  text-overflow: ellipsis;
}

@media (shape: pill-shaped) {
  .filter-panel {
    padding: 0 10px;
    border-radius: 14px;
  }
  .filter-header {
    height: 40px;
  }
  .filter-summary {
    font-size: 22px;
    text-align: center;
  }
  .filter-header {
    position: relative;
    justify-content: center;
  }
  .filter-arrow {
    position: absolute;
    right: 0px;
  }
  .filter-row {
    height: 64px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .filter-label,
  .filter-value {
    width: 100%;
    height: 28px;
    font-size: 22px;
    text-align: center;
    margin-right: 0px;
    flex-grow: 0;
    flex-basis: auto;
    flex-shrink: 0;
  }
}

@media (shape: rect) {
  .filter-panel {
    padding: 0 16px;
    border-radius: 14px;
  }
  .filter-header {
    height: 48px;
  }
  .filter-summary {
    font-size: 24px;
    height: 32px;
  }
  .filter-row {
    height: 48px;
  }
  .filter-label,
  .filter-value {
    font-size: 24px;
    height: 32px;
  }
}

@media (shape: circle) {
  .filter-panel {
    padding: 0 16px;
    border-radius: 14px;
  }
  .filter-header {
    height: 48px;
  }
  .filter-summary {
    font-size: 24px;
    height: 32px;
  }
  .filter-row {
    height: 48px;
  }
  .filter-label,
  .filter-value {
    font-size: 24px;
    height: 32px;
  }
}

.list-page {
  flex-direction: column;
  align-items: center;
  color: white;
  background-color: black;
}

.box {
  position: relative;
  flex: 1;
  width: 90%;
  margin-bottom: 86px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.event-list {
  flex: 1;
  width: 100%;
}

.event-item {
  width: 100%;
  height: 74px;
}

.countdown-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 66px;
  border-radius: 14px;
  margin-bottom: 0;
  overflow: hidden;
  background-color: white;
}

.card-header {
  display: flex;
  align-items: center;
  width: 65%;
  height: 100%;
  padding-left: 4px;
}

.countdown-name {
  font-size: 22px;
  text-overflow: ellipsis;
  font-weight: bold;
  color: white;
  lines: 2;
}

.card-body {
  display: flex;
  justify-content: center;
