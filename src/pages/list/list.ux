  height: 66px;
  text-overflow: clip;
  position: relative;
}

.count {
  margin-top: 116px;
  margin-bottom: 10px;
  font-weight: bold;
}

.pagination-item {
  width: 100%;
  height: 66px;
  margin-top: 6px;
}

.pagination-controls {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 100%;
}

.pagination-button {
  height: 46px;
  width: 64px;
  border-radius: 100%;
  border: 3px rgba(255, 255, 255, 0.24);
  background-color: #262626;
  justify-content: center;
  align-items: center;
}

.pagination-button-disabled {
  height: 46px;
  width: 64px;
  border-radius: 100%;
  border: 3px rgba(255, 255, 255, 0.06);
  background-color: rgba(38, 38, 38, 0.12);
  justify-content: center;
  align-items: center;
}

.text-normal {
  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
}

.text-disabled {
  font-size: 18px;
  color: #555555;
}

.page-indicator {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.8);
  font-weight: bold;
}

@media (device-type: band) and (shape: rect) {
  .event-item {
    height: 88px;
  }

  .countdown-card {
    height: 78px;
    margin-bottom: 0;
  }

  .card-header {
    width: 70%;
  }

  .countdown-name {
    font-size: 26px;
  }

  .card-body {
    width: 30%;
  }

  .countdown-days {
    height: 78px;
  }

  .box {
    margin-top: 92px;
    margin-bottom: 16px;
    width: 83%;
  }
}

@media (device-type: watch) and (shape: rect) {
  .event-item {
    height: 88px;
  }

  .countdown-card {
    height: 78px;
    margin-bottom: 0;
  }

  .card-header {
    width: 70%;
  }

  .countdown-name {
    font-size: 26px;
  }

  .card-body {
    width: 30%;
  }

  .countdown-days {
    height: 78px;
  }

