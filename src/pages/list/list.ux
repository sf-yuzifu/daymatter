  width: 100%;
  height: 66px;
  border-radius: 14px;
  margin-bottom: 8px;
  overflow: hidden;
  background-color: white;
}

.card-header {
  display: flex;
  align-items: center;
  width: 65%;
  height: 100%;
  padding-left: 4px;
}

.countdown-name {
  font-size: 22px;
  text-overflow: ellipsis;
  font-weight: bold;
  color: white;
  lines: 2;
}

.card-body {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 35%;
  height: 100%;
  background-color: white;
}

.countdown-days {
  color: black;
  font-weight: bold;
  text-align: center;
  width: 100%;
  height: 66px;
  text-overflow: clip;
  position: relative;
}

.count {
  margin-top: 116px;
  margin-bottom: 10px;
  font-weight: bold;
}

@media (device-type: band) and (shape: rect) {
  .countdown-card {
    height: 78px;
    margin-bottom: 10px;
  }

  .card-header {
    width: 70%;
  }

  .countdown-name {
    font-size: 26px;
  }

  .card-body {
    width: 30%;
  }

  .countdown-days {
    height: 78px;
  }

  .box {
    margin-top: 92px;
    margin-bottom: 16px;
    width: 83%;
  }
}

@media (device-type: watch) and (shape: rect) {
  .countdown-card {
    height: 78px;
    margin-bottom: 10px;
  }

  .card-header {
    width: 70%;
  }

  .countdown-name {
    font-size: 26px;
  }

  .card-body {
    width: 30%;
  }

  .countdown-days {
    height: 78px;
  }

  .box {
    margin-top: 102px;
    margin-bottom: 32px;
    width: 75%;
  }
}

@media (device-type: watch) and (shape: circle) {
  .countdown-card {
    height: 78px;
    margin-bottom: 10px;
  }

  .card-header {
    width: 70%;
  }

  .countdown-name {
    font-size: 26px;
  }

  .card-body {
    width: 30%;
  }

  .countdown-days {
    height: 78px;
  }

  .time-container {
    top: 18px;
  }

  .time-text {
    font-size: 28px;
  }

  .box {
    margin-top: 92px;
    margin-bottom: 84px;
    width: 70%;
  }
}
</style>
