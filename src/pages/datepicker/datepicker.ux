  font-size: 24px;
  color: #3184d0;
  font-weight: bold;
  padding: 10px;
}

/* 星期标题 */
.week-header {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-bottom: 5px;
}

.week-day {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.6);
  width: 14%;
  text-align: center;
}

/* 日历网格 */
.calendar-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  width: 100%;
}

.day-cell {
  width: 14%;
  justify-content: center;
  align-items: center;
}

.day-bg {
  width: 26px;
  height: 26px;
  border-radius: 4px;
  justify-content: center;
  align-items: center;
}

.today {
  background-color: #f78803;
}

.selected {
  background-color: #3184d0;
}

.day-text {
  font-size: 18px;
  color: white;
  font-weight: bold;
}

.other-month {
  color: rgba(255, 255, 255, 0.3);
}

.selected-text {
  font-weight: bold;
}

/* 选中日期显示 */
.selected-date {
  font-size: 24px;
  color: #3184d0;
  font-weight: bold;
  margin-top: 10px;
}

/* 适配圆形屏幕 */
@media (device-type: watch) and (shape: circle) {
  .month-selector {
    margin-top: 72px;
    margin-bottom: 2px;
  }

  .week-header, .calendar-grid {
    width: 85%;
  }
  
  .day-cell {
    height: 32px;
  }

  .month-text {
    font-size: 28px;
    margin: 0 20px;
  }

  .arrow {
    font-size: 28px;
  }
  
  .day-bg {
    width: 32px;
    height: 32px;
    border-radius: 16px;
  }
  
  .day-text {
    font-size: 20px;
  }
  
  .week-day {
    font-size: 16px;
  }

  .selected-date {
    font-size: 28px;
    margin-top: 0;
  }
}

@media (device-type: band) and (shape: rect) {
  .week-header, .calendar-grid {
    width: 90%;
  }

  .month-selector {
    margin-top: 86px;
  }

  .month-text {
    margin: 0 20px;
  }
  
  .day-cell {
    height: 32px;
  }
  
  .day-text {
    font-size: 20px;
  }

  .day-bg {
    width: 32px;
    height: 32px;
    border-radius: 16px;
  }

  .selected-date {
    font-size: 28px;
    margin-top: 24px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .week-header, .calendar-grid {
    width: 90%;
  }

  .month-selector {
    margin-top: 96px;
  }
  
  .day-cell {
    height: 42px;
  }
  
  .day-text {
    font-size: 24px;
  }

  .day-bg {
    width: 42px;
    height: 42px;
    border-radius: 21px;
  }

  .selected-date {
    font-size: 32px;
    margin-top: 12px;
  }

  .arrow {
    font-size: 28px;
  }
  
  .month-text {
    font-size: 28px;
    margin: 0 20px;
  }

  .week-day {
    font-size: 22px;
  }
}
</style>
</content>
