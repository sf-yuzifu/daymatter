  font-weight: bold;
  margin-top: 12px;
}

.countdown-event {
  font-size: 20px;
  text-align: center;
  width: 85%;
  position: relative;
  font-weight: bold;
}

.countdown-event-bg {
  height: 66px;
  margin: unset;
  padding: unset;
  display: flex;
  justify-content: center;
  align-items: center;
}

.countdown-days-bg {
  display: flex;
  flex-direction: column;
  position: relative;
  width: 100%;
  height: 126px;
  background-color: #efefef;
  color: black;
  justify-content: center;
  align-items: center;
}

.countdown-date-bg {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 50px;
  color: black;
  justify-content: center;
  align-items: center;
  border-radius: 20px;
}

.countdown-date-bg2 {
  position: absolute;
  background-color: #ffffff;
  width: 100%;
  height: 60px;
  bottom: 0;
  border-radius: 20px;
}
.countdown-date {
  text-align: center;
  font-size: 16px;
  color: rgba(0, 0, 0, 0.6);
}

.countdown-days {
  text-align: center;
  font-size: 56px;
  font-weight: bold;
}

@media (device-type: band) and (shape: rect) {
  .countdown-swiper {
    width: 256px;
    height: 256px;
  }

  .countdown-page {
    width: 256px;
    height: 256px;
    border-radius: 24px;
  }

  .countdown-event {
    font-size: 24px;
  }

  .countdown-event-bg {
    height: 66px;
  }

  .countdown-days-bg {
    height: 178px;
  }

  .countdown-date-bg {
    height: 64px;
  }

  .countdown-date-bg2 {
    height: 74px;
    border-radius: 24px;
  }

  .countdown-date {
    font-size: 20px;
    font-weight: bold;
  }

  .countdown-days {
    font-size: 88px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .countdown-swiper {
    width: 300px;
    height: 300px;
  }

  .countdown-page {
    width: 300px;
    height: 300px;
    border-radius: 32px;
  }

  .countdown-event {
    font-size: 28px;
  }

  .countdown-event-bg {
    height: 66px;
  }

  .countdown-days-bg {
    height: 178px;
  }

  .countdown-date-bg {
    height: 64px;
  }

  .countdown-date-bg2 {
    height: 84px;
    border-radius: 32px;
  }

  .countdown-date {
    font-size: 24px;
    font-weight: bold;
  }

  .countdown-days {
    font-size: 96px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .countdown-swiper {
    width: 300px;
    height: 300px;
  }

  .countdown-page {
    width: 300px;
    height: 300px;
    border-radius: 32px;
  }

  .countdown-event {
    font-size: 28px;
  }

  .countdown-event-bg {
    height: 66px;
  }

  .countdown-days-bg {
    height: 178px;
  }

  .countdown-date-bg {
    height: 64px;
  }

  .countdown-date-bg2 {
    height: 84px;
    border-radius: 32px;
  }

  .countdown-date {
    font-size: 24px;
    font-weight: bold;
  }

  .countdown-days {
    font-size: 86px;
  }
}
</style>
