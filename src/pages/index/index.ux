<template>
  <div class="index-page">
    <img
      class="bg"
      if="{{ contentVisible && bgImage }}"
      style="width: {{ global.screenSize.width }};height: {{ global.screenSize.height }};"
      src="{{ bgImage }}"
    />
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">{{ $t("appName") }}</text>
    <img
      class="top rightButton"
      if="{{ global.screenShape == 'rect' }}"
      src="/common/info_rect.png"
      @click="info"
    />
    <text class="title" elif="{{ global.screenShape == 'circle' }}" @click="info">
      {{ $t("appName") }}
    </text>
    <img else class="top" src="/common/info.png" @click="info" />
    <img
      class="top leftButton"
      if="{{ global.screenShape == 'rect' }}"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <swiper
      if="{{ contentVisible && !is_no_event }}"
      index="{{ swiperIndex }}"
      indicator="false"
      class="countdown-swiper"
      @change="onSwiperChange"
    >
      <div for="{{ slots }}">
        <div class="countdown-page">
          <div class="countdown-header" style="background-color: {{ $item.themeColor }}">
            <marquee
              if="{{ pageVisible && $item.nameOverflow && activeSourceIndex === $item.sourceIndex }}"
              id="home-marquee"
              class="countdown-event"
              scrollamount="{{ 20 }}"
              text-offset="{{ 20 }}"
            >
              {{ $item.name }}
            </marquee>
            <text else class="countdown-event">{{ $item.name }}</text>
          </div>
          <div class="countdown-body" @click="toggleDisplayMode($item.sourceIndex)">
            <text class="countdown-days" style="font-size: {{ $item.fontSize }}px;">
              {{ $item.displayText }}
            </text>
          </div>
          <div class="countdown-footer">
            <text class="countdown-date">{{ $t("targetDate", {date: $item.date}) }}</text>
          </div>
        </div>
      </div>
    </swiper>
    <div id="empty" if="{{ contentVisible && is_no_event }}">
      <img src="/common/empty.png" />
      <text id="emp">{{ $t("empty") }}</text>
    </div>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="bottom rightButton"
      src="/common/more_rect.png"
      @click="routeMore"
    />
    <img else class="bottom" src="/common/more.png" @click="routeMore" />
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"
import {showToast} from "@system.prompt"
import interconnect from "@system.interconnect"
import interconnectHub from "../../components/interconnectHub"

const DISPLAY_MODES = ["days", "weeks", "months", "years"]

const BASE_FONT_SIZES = Object.freeze({
  band: Object.freeze({rect: 76, pill: 56}),
  watch: Object.freeze({rect: 92, circle: 92})
})

const LENGTH_FACTORS = Object.freeze([
  Object.freeze({max: 3, factor: 0.9}),
  Object.freeze({max: 5, factor: 0.75}),
  Object.freeze({max: 7, factor: 0.56}),
  Object.freeze({max: 9, factor: 0.48}),
  Object.freeze({max: 12, factor: 0.38}),
  Object.freeze({max: 99, factor: 0.3})
])

// 跑马灯只在当前可见卡片且名称估算超宽时启用；每个汉字按字号计宽，其余字符约 0.6 倍
const MARQUEE_CHAR_FACTOR = 0.6

function getNameMetrics() {
  const deviceType = global.deviceType || "watch"
  const screenShape = global.screenShape || "pill-shaped"
  if (deviceType === "watch") {
    return {fontSize: 28, width: 300 * 0.85}
  }
  if (deviceType === "band" && screenShape === "rect") {
    return {fontSize: 24, width: 256 * 0.85}
  }
  return {fontSize: 20, width: 178 * 0.85}
}

function isNameOverflow(name, fontSize, availableWidth) {
  let textWidth = 0
  for (let i = 0; i < name.length; i++) {
    textWidth += name.charCodeAt(i) > 0x2e7f ? fontSize : fontSize * MARQUEE_CHAR_FACTOR
  }
  return textWidth > availableWidth
}

let connect

export default {
  private: {
    time: "",
    events: [],
    slots: [],
    is_no_event: true,
    bgImage: "",
    pageVisible: false,
    contentVisible: false,
    activeSourceIndex: -1,
    swiperIndex: 0
  },

  onInit() {
    this.allEvents = 0
    this.currentDisplayModeIndex = 0
    this._currentSlot = 0
    this._currentSource = 0
    this._destroyed = false
    this._needsRefresh = false
    this._messageHandler = null
    this._ticker = global.createMinuteTicker((dateChanged) => this.handleMinuteTick(dateChanged))
    connect = interconnectHub.getConnection(interconnect)
    if (!connect) return
    // 订阅应用级分发：处理器只在页面存活期间挂载，销毁时解除
    this._messageHandler = (message) => this.handleInterconnectMessage(message)
    interconnectHub.subscribeMessage(this._messageHandler)
  },

  handleInterconnectMessage(message) {
    if (this._destroyed) return
    let parsedData
    try {
      parsedData = JSON.parse(message.data)
    } catch (e) {
      console.error("JSON parse error:", e)
      return
    }

    showToast({message: parsedData.type, duration: 200})

    const handlers = {
      getAllEvent: () => this.handleGetAllEvent(),
      addEvent: () => this.handleAddEvent(parsedData),
      changeEvent: () => this.handleChangeEvent(parsedData),
      deleteEvent: () => this.handleDeleteEvent(parsedData),
      addBG: () => this.handleAddBG(parsedData)
    }

    const handler = handlers[parsedData.type]
    if (handler) handler()
  },

  onShow() {
    this.pageVisible = true
    this.contentVisible = true
    this.time = global.getTime()
    this.loadBackground()
    this.completed()
    this._ticker.start()
  },

  onHide() {
    // 离开页面立即停止跑马灯与分钟时钟，并释放重内容节点；卡片位置由 _currentSource 保留
    this.pageVisible = false
    this.contentVisible = false
    this.events = []
    this.slots = []
    this.activeSourceIndex = -1
    this._ticker.stop()
  },

  onDestroy() {
    this._destroyed = true
    this._ticker.stop()
    if (this._messageHandler) {
      interconnectHub.unsubscribeMessage(this._messageHandler)
      this._messageHandler = null
    }
    this.events = []
    this.slots = []
    this.bgImage = ""
    this.activeSourceIndex = -1
    this._needsRefresh = false
    if (typeof global.tryRunGC === "function") global.tryRunGC()
  },

  handleMinuteTick(dateChanged) {
    if (this._destroyed) return
    this.time = global.getTime()
    if (dateChanged) {
      // 跨午夜后重新计算全部倒数天数
      this.completed()
    }
  },

  onReady() {
    router.clear()
  },

  formatEvent(event, mode, sourceIndex, nameMetrics) {
    const diff = global.dateDiff(event.date)
    let accurateDiff = global.getDateDiffAccurate(event.date)
    let name = event.name
    let days
    let already = true
    let isToday = false
    let themeColor = event.themeColor

    if (diff > 0 || (diff === 0 && event.IFStaringDay)) {
      name = name + this.$t("already")
      days = diff > 0 ? (event.IFStaringDay ? diff + 1 : diff) : 1
      // IFStaringDay 启用时，accurateDiff 的天数也需要加 1
      if (event.IFStaringDay && diff > 0) {
        accurateDiff = {
          ...accurateDiff,
          days: accurateDiff.days + 1
        }
      }
    } else if (diff === 0) {
      days = 0
      isToday = true
    } else {
      name = name + this.$t("remaining")
      days = -diff
      already = false
    }

    // 根据事件状态调整主题色色调
    themeColor = global.adjustThemeColor(themeColor, already)

    // 根据显示模式生成显示文本和字体大小
    const displayInfo = this.getDisplayInfo(days, accurateDiff, mode, isToday)

    return {
      name,
      days: String(days),
      accurateDiff,
      displayText: displayInfo.text,
      fontSize: displayInfo.fontSize,
      date: event.date,
      already,
      themeColor,
      isToday,
      sourceIndex,
      nameOverflow: isNameOverflow(name, nameMetrics.fontSize, nameMetrics.width)
    }
  },

  getDisplayInfo(days, accurateDiff, mode, isToday) {
    if (isToday) {
      return {text: this.$t("today"), fontSize: this.calculateFontSize(2)}
    }

    // 如果不能显示当前模式，回退到纯天数
    if (!this.canShowMode(days, accurateDiff, mode, isToday)) {
      const text = days + this.$t("days")
      return {
        text,
        fontSize: this.calculateFontSize(text.length)
      }
    }

    const {
      years: accYears,
      months: accMonths,
      days: accDays
    } = accurateDiff || {years: 0, months: 0, days: 0}

    let text = ""
    let len = 1

    switch (mode) {
      case "weeks": {
        const weeks = Math.floor(days / 7)
        const remainingDays = days % 7
        text =
          remainingDays > 0
            ? `${weeks}${this.$t("weeks")}${remainingDays}${this.$t("days")}`
            : `${weeks}${this.$t("weeks")}`
        len = text.length
        break
      }
      case "months": {
        const totalMonths = accYears * 12 + accMonths
        text =
          accDays > 0
            ? `${totalMonths}${this.$t("months")}${accDays}${this.$t("days")}`
            : `${totalMonths}${this.$t("months")}`
        len = text.length
        break
      }
      case "years": {
        text = `${accYears}${this.$t("years")}`
        if (accMonths > 0) text += `${accMonths}${this.$t("months")}`
        if (accDays > 0) text += `${accDays}${this.$t("days")}`
        len = text.length
        break
      }
      case "days":
      default:
        text = days
        len = 1
        break
    }

    return {
      text,
      fontSize: this.calculateFontSize(len)
    }
  },

  calculateFontSize(textLength) {
    // 根据设备类型和文字长度计算字体大小
    const deviceType = global.deviceType || "watch"
    const screenShape = global.screenShape || "pill-shaped"
    const isPillShaped = global.isPillShaped || false

    let baseSize
    if (deviceType === "band" && isPillShaped) {
      baseSize = BASE_FONT_SIZES.band.pill
    } else {
      baseSize = BASE_FONT_SIZES[deviceType]?.[screenShape] || 92
    }

    const factor = LENGTH_FACTORS.find((f) => textLength <= f.max)?.factor || 0.35
    return Math.floor(baseSize * factor)
  },

  toggleDisplayMode(index) {
    // 获取当前事件的信息（用于判断能否切换到某个模式）
    const currentEvent = this.events[index]
    if (!currentEvent) return
    const days = parseInt(currentEvent.days)
    const accurateDiff = currentEvent.accurateDiff
    const isToday = currentEvent.isToday !== undefined ? currentEvent.isToday : (currentEvent.displayText === this.$t("today"))

    // 尝试切换到下一个模式，如果无法显示则继续尝试
    let attempts = 0
    let newMode
    do {
      this.currentDisplayModeIndex = (this.currentDisplayModeIndex + 1) % DISPLAY_MODES.length
      newMode = DISPLAY_MODES[this.currentDisplayModeIndex]
      attempts++
    } while (
      !this.canShowMode(days, accurateDiff, newMode, isToday) &&
      attempts < DISPLAY_MODES.length
    )

    // 原地更新所有事件的展示文本和字号，避免重新创建对象及破坏 Swiper 节点池
    for (let i = 0; i < this.events.length; i++) {
      const event = this.events[i]
      const eventDays = parseInt(event.days)
      const eventAccurateDiff = event.accurateDiff
      const eventIsToday = event.isToday !== undefined ? event.isToday : (event.displayText === this.$t("today"))
      const displayInfo = this.getDisplayInfo(eventDays, eventAccurateDiff, newMode, eventIsToday)
      if (event.displayText !== displayInfo.text) {
        event.displayText = displayInfo.text
      }
      if (event.fontSize !== displayInfo.fontSize) {
        event.fontSize = displayInfo.fontSize
      }
    }
  },

  canShowMode(days, accurateDiff, mode, isToday) {
    if (isToday) return true
    const {years, months} = accurateDiff || {years: 0, months: 0}
    switch (mode) {
      case "days":
        return true
      case "weeks":
        return Math.floor(days / 7) >= 1
      case "months":
        return months > 0 || years > 0
      case "years":
        return years > 0
      default:
        return true
    }
  },

  completed() {
    file.readText({
      uri: "internal://files/events.json",
      success: (data) => {
        if (this._destroyed) return
        if (!this.pageVisible) {
          // 隐藏页只标记需要刷新，不在隐藏 UI 上重建
          this._needsRefresh = true
          return
        }
        let events
        try {
          events = JSON.parse(data.text)
        } catch (e) {
          events = []
        }
        if (!Array.isArray(events)) events = []
        this.allEvents = events.length
        const currentMode = DISPLAY_MODES[this.currentDisplayModeIndex]
        const nameMetrics = getNameMetrics()
        this.events = events
          .filter((e) => e.on_index)
          .map((e, i) => this.formatEvent(e, currentMode, i, nameMetrics))
        this._needsRefresh = false
        this.setupSlots()
      },
      fail: (data, code) => {
        if (this._destroyed) return
        console.error(`handling fail, code = ${code}`)
      }
    })
  },

  setupSlots() {
    // 首页最多保留三个槽位：当前、下一个、上一个（循环），并恢复上次浏览的卡片
    const total = this.events.length
    this.is_no_event = total === 0
    this.swiperIndex = 0
    if (total === 0) {
      this.slots = []
      this.activeSourceIndex = -1
      this._currentSlot = 0
      this._currentSource = 0
      return
    }
    let source = this._currentSource
    if (source < 0) source = 0
    if (source >= total) source = total - 1
    this._currentSource = source
    if (total <= 3) {
      this.slots = this.events.slice(0, total)
      this._currentSlot = source
      this.swiperIndex = source
    } else {
      this.slots = [
        this.events[source],
        this.events[(source + 1) % total],
        this.events[(source - 1 + total) % total]
      ]
      this._currentSlot = 0
      this.swiperIndex = 0
    }
    this.activeSourceIndex = source
    this.resumeMarquee()
  },

  onSwiperChange(event) {
    const total = this.events.length
    if (total <= 1) return
    const slotCount = this.slots.length
    const newSlot = event && event.index >= 0 && event.index < slotCount ? event.index : 0
    const oldSlot = this._currentSlot
    if (newSlot === oldSlot) return

    let newSource
    if (total > 3 && slotCount === 3) {
      const step = (newSlot - oldSlot + 3) % 3
      if (step === 1) {
        // 前进：把两页之前的出屏槽位原地换成新的下一个事件
        newSource = (this._currentSource + 1) % total
        this.slots[(newSlot + 1) % 3] = this.events[(newSource + 1) % total]
      } else if (step === 2) {
        // 后退：把两页之前的出屏槽位原地换成新的上一个事件
        newSource = (this._currentSource - 1 + total) % total
        this.slots[(newSlot + 2) % 3] = this.events[(newSource - 1 + total) % total]
      } else {
        newSource = this._currentSource
      }
    } else {
      newSource = newSlot
    }

    this._currentSlot = newSlot
    this._currentSource = newSource
    this.swiperIndex = newSlot
    this.activeSourceIndex = newSource
    this.resumeMarquee()
  },

  resumeMarquee() {
    const resume = () => {
      const marquee = this.$element("home-marquee")
      if (marquee && typeof marquee.start === "function") {
        marquee.start()
      }
    }
    if (typeof this.$nextTick === "function") {
      this.$nextTick(resume)
    } else {
      resume()
    }
  },

  readEvents(successCallback) {
    file.readText({
      uri: "internal://files/events.json",
      success: (data) => {
        if (this._destroyed) return
        let events
        try {
          events = JSON.parse(data.text)
        } catch (e) {
          events = []
        }
        if (!Array.isArray(events)) events = []
        successCallback(events)
      },
      fail: () => {
        if (this._destroyed) return
        successCallback([])
      }
    })
  },

  writeEvents(events, successMsgKey) {
    file.writeText({
      uri: "internal://files/events.json",
      text: JSON.stringify(events),
      success: () => {
        if (this._destroyed) return
        showToast({message: this.$t(successMsgKey), duration: 2000})
        if (this.pageVisible) {
          this.completed()
        } else {
          // 隐藏页只标记需要刷新，等 onShow 再统一重建
          this._needsRefresh = true
        }
      },
      fail: (data, code) => {
        if (this._destroyed) return
        showToast({message: this.$t("saveFail", {code})})
      }
    })
  },

  handleGetAllEvent() {
    if (this._destroyed) return
    this.readEvents((events) => {
      connect.send({
        data: {data: events},
        success: () => {
          if (this._destroyed) return
          showToast({message: this.$t("syncSuccess"), duration: 2000})
        },
        fail: () => {
          if (this._destroyed) return
          showToast({message: this.$t("syncFail"), duration: 2000})
        }
      })
    })
  },

  handleAddEvent(data) {
    if (this._destroyed) return
    this.readEvents((events) => {
      const eventData = {
        name: data.name,
        date: data.date,
        on_index: data.on_index,
        IFStaringDay: data.IFStaringDay,
        themeColor: data.themeColor
      }
      events.push(eventData)
      this.writeEvents(events, "addSuccess")
    })
  },

  handleChangeEvent(data) {
    if (this._destroyed) return
    this.readEvents((events) => {
      const {index} = data
      if (index >= 0 && index < events.length) {
        events[index] = {
          ...events[index],
          name: data.name !== undefined ? data.name : events[index].name,
          date: data.date !== undefined ? data.date : events[index].date,
          on_index: data.on_index !== undefined ? data.on_index : events[index].on_index,
          IFStaringDay: data.IFStaringDay !== undefined ? data.IFStaringDay : events[index].IFStaringDay,
          themeColor: data.themeColor !== undefined ? data.themeColor : events[index].themeColor
        }
        this.writeEvents(events, "changeSuccess")
      }
    })
  },

  handleDeleteEvent(data) {
    if (this._destroyed) return
    this.readEvents((events) => {
      if (data.index >= 0 && data.index < events.length) {
        events.splice(data.index, 1)
        this.writeEvents(events, "deleteSuccess")
      }
    })
  },

  handleAddBG(data) {
    if (this._destroyed) return
    const {bgBase64} = data
    if (!bgBase64) {
      showToast({message: "No image data", duration: 2000})
      return
    }

    const timestamp = Date.now()
    const newFileUri = `internal://files/bg_${timestamp}.png`
    const oldFileUri = this.bgImage

    const saveBackground = () => {
      if (this._destroyed) return
      try {
        const arrayBuffer = global.base64ToArrayBuffer(bgBase64)
        const uint8Array = new Uint8Array(arrayBuffer)

        file.writeArrayBuffer({
          uri: newFileUri,
          buffer: uint8Array,
          success: () => {
            if (this._destroyed) return
            if (this.pageVisible) {
              this.bgImage = newFileUri
            } else {
              this._needsRefresh = true
            }
            showToast({message: this.$t("bgUpdateSuccess"), duration: 2000})
          },
          fail: (d, code) => {
            if (this._destroyed) return
            showToast({message: this.$t("bgSaveFail", {code}), duration: 2000})
          }
        })
      } catch (e) {
        console.error("Save background error:", e)
        showToast({message: this.$t("bgSaveFail"), duration: 2000})
      }
    }

    if (oldFileUri && oldFileUri.startsWith("internal://files/bg_")) {
      file.delete({
        uri: oldFileUri,
        success: saveBackground,
        fail: saveBackground
      })
    } else {
      saveBackground()
    }
  },

  loadBackground() {
    file.list({
      uri: "internal://files/",
      success: (data) => {
        if (this._destroyed) return
        const bgFiles = (data.fileList || [])
          .filter(f => f.uri && f.uri.match(/bg_\d+\.png$/))
          .sort((a, b) => {
            const timeA = parseInt(a.uri.match(/bg_(\d+)\.png/)[1])
            const timeB = parseInt(b.uri.match(/bg_(\d+)\.png/)[1])
            return timeB - timeA
          })
        // 无自定义背景时留空，直接用黑色底色，不创建 blank.png 背景节点
        this.bgImage = bgFiles.length > 0 ? bgFiles[0].uri : ""
      },
      fail: () => {
        if (this._destroyed) return
        this.bgImage = ""
      }
    })
  },

  info() {
    router.push({
      uri: "/pages/about"
    })
  },

  routeBack() {
    router.back()
  },

  routeMore() {
    if (this.allEvents === 0) {
      router.push({
        uri: "/pages/edit",
        params: {
          extend: "true",
          callback_uri: "/pages/index"
        }
      })
    } else {
      router.push({uri: "/pages/list"})
    }
  }
}
</script>

<style>
@import "../../common/app.css";

.index-page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  color: white;
  background-color: black;
}

.bg {
  position: absolute;
  top: 0;
  left: 0;
}

.countdown-swiper {
  width: 178px;
  height: 178px;
}

.countdown-page {
  display: flex;
  flex-direction: column;
  width: 178px;
  height: 178px;
  border-radius: 20px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: #fff;
}

#empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

#emp {
  font-weight: bold;
  margin-top: 12px;
}

.countdown-header {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 40px;
}

.countdown-event {
  font-size: 20px;
  text-align: center;
  width: 85%;
  font-weight: bold;
  color: white;
  lines: 1;
  text-overflow: ellipsis;
}

.countdown-body {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  border-radius: 1px; /* 这个是解决9和9Pro不知道为啥加圆角会少一点像素的问题的 */
  flex: 1;
}

.countdown-days {
  text-align: center;
  font-size: 56px;
  font-weight: bold;
  color: #000;
}

.countdown-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 36px;
  background-color: #efefef;
}

.countdown-date {
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  color: #666666;
}

@media (device-type: band) and (shape: rect) {
  .countdown-swiper {
    width: 256px;
    height: 256px;
  }

  .countdown-page {
    width: 256px;
    height: 256px;
    border-radius: 24px;
