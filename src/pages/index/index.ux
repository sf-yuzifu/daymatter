<template>
  <div class="index-page">
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">{{ $t("appName") }}</text>
    <img
      class="top rightButton"
      if="{{ global.screenShape == 'rect' }}"
      src="/common/info_rect.png"
      @click="info"
    />
    <text class="title" elif="{{ global.screenShape == 'circle' }}" @click="info">
      {{ $t("appName") }}
    </text>
    <img else class="top" src="/common/info.png" @click="info" />
    <img
      class="top leftButton"
      if="{{ global.screenShape == 'rect' }}"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <swiper if="{{ !is_no_event }}" indicator="false" class="countdown-swiper">
      <div for="{{ events }}">
        <div class="countdown-page">
          <div class="countdown-header" style="background-color: {{ $item.themeColor }}">
            <marquee class="countdown-event" scrollamount="{{ 20 }}" text-offset="{{ 20 }}">
              {{ $item.name }}
            </marquee>
          </div>
          <div class="countdown-body" @click="toggleDisplayMode($idx)">
            <text class="countdown-days" style="font-size: {{ $item.fontSize }}px;">{{ $item.displayText }}</text>
          </div>
          <div class="countdown-footer">
            <text class="countdown-date">{{ $t("targetDate", {date: $item.date}) }}</text>
          </div>
        </div>
      </div>
    </swiper>
    <div id="empty" if="{{ is_no_event }}">
      <img src="/common/empty.png" />
      <text id="emp">{{ $t("empty") }}</text>
    </div>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="bottom rightButton"
      src="/common/more_rect.png"
      @click="routeMore"
    />
    <img else class="bottom" src="/common/more.png" @click="routeMore" />
  </div>
</template>

<script>
import router from "@system.router"
import file from "@system.file"
import {showToast} from "@system.prompt"
import interconnect from "@system.interconnect"

let connect, isOnMessageRegistered

export default {
  private: {
    time: "",
    events: [],
    is_no_event: true,
    allEvents: 0,
    displayModes: ["days", "weeks", "months", "years"],
    currentDisplayModeIndex: 0
  },

  onInit() {
    connect = interconnect.instance()
    // 如果 interconnect 不可用，直接返回
    if (!connect) {
      return
    }
    if (isOnMessageRegistered) {
      return
    }
    isOnMessageRegistered = true

    connect.onmessage = (message) => {
      let parsedData
      try {
        parsedData = JSON.parse(message.data)
      } catch (e) {
        console.error("JSON parse error:", e)
        return
      }

      showToast({message: parsedData.type, duration: 200})

      const handlers = {
        getAllEvent: () => this.handleGetAllEvent(),
        addEvent: () => this.handleAddEvent(parsedData),
        changeEvent: () => this.handleChangeEvent(parsedData),
        deleteEvent: () => this.handleDeleteEvent(parsedData)
      }

      const handler = handlers[parsedData.type]
      if (handler) handler()
    }
  },

  onShow() {
    this.time = global.getTime()
  },

  onReady() {
    router.clear()
    this.completed()
  },

  formatEvent(event, mode) {
    const diff = global.dateDiff(event.date)
    const accurateDiff = global.getDateDiffAccurate(event.date)
    let name = event.name
    let days
    let already = true
    let themeColor = event.themeColor

    if (diff > 0 || (diff === 0 && event.IFStaringDay)) {
      name = name + this.$t("already")
      days = diff > 0 ? (event.IFStaringDay ? diff + 1 : diff) : 1
    } else if (diff === 0) {
      days = 0
    } else {
      name = name + this.$t("remaining")
      days = -diff
      already = false
    }

    // 根据事件状态调整主题色色调
    themeColor = global.adjustThemeColor(themeColor, already)

    // 根据显示模式生成显示文本和字体大小
    const displayInfo = this.getDisplayInfo(days, accurateDiff, mode, already)

    return {
      name,
      days: String(days),
      accurateDiff,
      displayText: displayInfo.text,
      fontSize: displayInfo.fontSize,
      date: event.date,
      already,
      themeColor
    }
  },

  getDisplayInfo(days, accurateDiff, mode, isToday) {
    if (isToday) {
      return { text: this.$t("today"), fontSize: this.calculateFontSize(2) }
    }

    // 使用准确的日期差值
    const { years: accYears, months: accMonths, days: accDays } = accurateDiff || { years: 0, months: 0, days: 0 }

    // 检查当前模式是否能显示有意义的更大单位（使用准确的年/月）
    const canShowMode = {
      days: () => true,
      weeks: () => Math.floor(days / 7) >= 1,
      months: () => accMonths > 0 || accYears > 0,
      years: () => accYears > 0
    }

    // 如果不能显示当前模式，回退到纯天数
    if (!canShowMode[mode] || !canShowMode[mode]()) {
      const text = days + this.$t("days")
      return {
        text: text,
        fontSize: this.calculateFontSize(text.length)
      }
    }

    const modeHandlers = {
      days: () => ({
        text: days,
        length: 1
      }),
      weeks: () => {
        const weeks = Math.floor(days / 7)
        const remainingDays = days % 7
        const text = remainingDays > 0
          ? `${weeks}${this.$t("weeks")}${remainingDays}${this.$t("days")}`
          : `${weeks}${this.$t("weeks")}`
        return { text, length: text.length }
      },
      months: () => {
        // 使用准确的月份和天数
        const totalMonths = accYears * 12 + accMonths
        const text = accDays > 0
          ? `${totalMonths}${this.$t("months")}${accDays}${this.$t("days")}`
          : `${totalMonths}${this.$t("months")}`
        return { text, length: text.length }
      },
      years: () => {
        // 使用准确的年、月、天
        let text = `${accYears}${this.$t("years")}`
        if (accMonths > 0) text += `${accMonths}${this.$t("months")}`
        if (accDays > 0) text += `${accDays}${this.$t("days")}`
        return { text, length: text.length }
      }
    }

    const handler = modeHandlers[mode] || modeHandlers.days
    const result = handler()
    return {
      text: result.text,
      fontSize: this.calculateFontSize(result.length)
    }
  },

  calculateFontSize(textLength) {
    // 根据设备类型和文字长度计算字体大小
    const deviceType = global.deviceType || 'watch'
    const screenShape = global.screenShape || 'rect'
    const isPillShaped = global.isPillShaped || false

    // 基础字体大小配置
    // 药丸手环 countdown-page 只有 178px，比其他设备小很多
    const baseSizes = {
      band: { rect: 76, pill: 56 },
      watch: { rect: 92, circle: 92 }
    }

    let baseSize
    if (deviceType === 'band' && isPillShaped) {
      baseSize = baseSizes.band.pill
    } else {
      baseSize = baseSizes[deviceType]?.[screenShape] || 92
    }

    // 根据文字长度调整字体大小
    const lengthFactors = [
      { max: 3, factor: 0.9 },    // 1-3个字符：90%
      { max: 5, factor: 0.75 },   // 4-5个字符：75%
      { max: 7, factor: 0.56 },    // 6-7个字符：56%
      { max: 9, factor: 0.48 },   // 8-9个字符：48%
      { max: 12, factor: 0.38 },  // 10-12个字符：38%
      { max: 99, factor: 0.3 }    // 超过12个字符：30%
    ]

    const factor = lengthFactors.find(f => textLength <= f.max)?.factor || 0.35
    return Math.floor(baseSize * factor)
  },

  toggleDisplayMode(index) {
    // 获取当前事件的信息（用于判断能否切换到某个模式）
    const currentEvent = this.events[index]
    const days = parseInt(currentEvent.days)
    const accurateDiff = currentEvent.accurateDiff
    const isToday = currentEvent.displayText === this.$t("today")

    // 尝试切换到下一个模式，如果无法显示则继续尝试
    let attempts = 0
    let newMode
    do {
      this.currentDisplayModeIndex = (this.currentDisplayModeIndex + 1) % this.displayModes.length
      newMode = this.displayModes[this.currentDisplayModeIndex]
      attempts++
    } while (!this.canShowMode(days, accurateDiff, newMode, isToday) && attempts < this.displayModes.length)

    // 重新格式化所有事件
    this.events = this.events.map(event => {
      const eventDays = parseInt(event.days)
      const eventAccurateDiff = event.accurateDiff
      const eventIsToday = event.displayText === this.$t("today")
      const displayInfo = this.getDisplayInfo(eventDays, eventAccurateDiff, newMode, eventIsToday)
      return {
        ...event,
        displayText: displayInfo.text,
        fontSize: displayInfo.fontSize
      }
    })
  },

  canShowMode(days, accurateDiff, mode, isToday) {
    if (isToday) return true
    const { years, months } = accurateDiff || { years: 0, months: 0 }
    switch (mode) {
      case 'days': return true
      case 'weeks': return Math.floor(days / 7) >= 1
      case 'months': return months > 0 || years > 0
      case 'years': return years > 0
      default: return true
    }
  },

  completed() {
    file.readText({
      uri: "internal://files/events.json",
      success: (data) => {
        const events = JSON.parse(data.text)
        this.allEvents = events.length
        const currentMode = this.displayModes[this.currentDisplayModeIndex]
        this.events = events.filter((e) => e.on_index).map((e) => this.formatEvent(e, currentMode))
        this.is_no_event = this.events.length === 0
      },
      fail: (data, code) => console.log(`handling fail, code = ${code}`)
    })
  },

  readEvents(successCallback) {
    file.readText({
      uri: "internal://files/events.json",
      success: (data) => {
        let events
        try {
          events = JSON.parse(data.text)
        } catch (e) {
          events = []
        }
        successCallback(events)
      },
      fail: () => successCallback([])
    })
  },

  writeEvents(events, successMsgKey) {
    file.writeText({
      uri: "internal://files/events.json",
      text: JSON.stringify(events),
      success: () => {
        showToast({message: this.$t(successMsgKey), duration: 2000})
        this.completed()
      },
      fail: (data, code) => {
        showToast({message: this.$t("saveFail", {code})})
      }
    })
  },

  handleGetAllEvent() {
    this.readEvents((events) => {
      connect.send({
        data: {data: events},
        success: () => showToast({message: this.$t("syncSuccess"), duration: 2000}),
        fail: () => showToast({message: this.$t("syncFail"), duration: 2000})
      })
    })
  },

  handleAddEvent(data) {
    this.readEvents((events) => {
      const {type, ...eventData} = data
      events.push(eventData)
      this.writeEvents(events, "addSuccess")
    })
  },

  handleChangeEvent(data) {
    this.readEvents((events) => {
      const {type, index, ...eventData} = data
      if (index >= 0 && index < events.length) {
        events[index] = eventData
        this.writeEvents(events, "changeSuccess")
      }
    })
  },

  handleDeleteEvent(data) {
    this.readEvents((events) => {
      if (data.index >= 0 && data.index < events.length) {
        events.splice(data.index, 1)
        this.writeEvents(events, "deleteSuccess")
      }
    })
  },

  info() {
    router.push({
      uri: "/pages/about"
    })
  },

  routeBack() {
    router.back()
  },

  routeMore() {
    if (this.allEvents === 0) {
      router.push({
        uri: "/pages/edit",
        params: {
          extend: "true",
          callback_uri: "/pages/index"
        }
      })
    } else {
      router.push({uri: "/pages/list"})
    }
  }
}
</script>

<style>
@import "../../common/app.css";

.index-page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  background-color: black;
}

.countdown-swiper {
  width: 178px;
  height: 178px;
}

.countdown-page {
  display: flex;
  flex-direction: column;
  width: 178px;
  height: 178px;
  border-radius: 20px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: #fff;
}

#empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

#empty #emp {
  font-weight: bold;
  margin-top: 12px;
}

.countdown-header {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 40px;
}

.countdown-event {
  font-size: 20px;
  text-align: center;
  width: 85%;
  font-weight: bold;
  color: white;
}

.countdown-body {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  border-radius: 1px; /* 这个是解决9和9Pro不知道为啥加圆角会少一点像素的问题的 */
  flex: 1;
}

.countdown-days {
  text-align: center;
  font-size: 56px;
  font-weight: bold;
  color: #000;
}

.countdown-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 36px;
  background-color: #efefef;
}

.countdown-date {
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  color: #666666;
}

@media (device-type: band) and (shape: rect) {
  .countdown-swiper {
    width: 256px;
    height: 256px;
  }

  .countdown-page {
    width: 256px;
    height: 256px;
    border-radius: 24px;
  }

  .countdown-header {
    height: 56px;
  }

  .countdown-event {
    font-size: 24px;
  }

  .countdown-footer {
    height: 48px;
  }

  .countdown-date {
    font-size: 20px;
  }

  .countdown-days {
    font-size: 76px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .countdown-swiper {
    width: 300px;
    height: 300px;
  }

  .countdown-page {
    width: 300px;
    height: 300px;
    border-radius: 32px;
  }

  .countdown-header {
    height: 66px;
  }

  .countdown-event {
    font-size: 28px;
  }

  .countdown-footer {
    height: 64px;
  }

  .countdown-date {
    font-size: 24px;
  }

  .countdown-days {
    font-size: 92px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .countdown-swiper {
    width: 300px;
    height: 300px;
  }

  .countdown-page {
    width: 300px;
    height: 300px;
    border-radius: 32px;
  }

  .countdown-header {
    height: 66px;
  }

  .countdown-event {
    font-size: 28px;
  }

  .countdown-footer {
    height: 64px;
  }

  .countdown-date {
    font-size: 24px;
  }

  .countdown-days {
    font-size: 92px;
  }
}
</style>
