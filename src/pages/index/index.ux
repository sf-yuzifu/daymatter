<template>
  <div class="index-page">
    <img
      class="bg"
      if="{{ contentVisible && bgImage }}"
      style="width: {{ global.screenSize.width }};height: {{ global.screenSize.height }};"
      src="{{ bgImage }}"
    />
    <text class="time">{{ time }}</text>
    <text class="title" if="{{ global.screenShape == 'rect' }}">{{ $t("appName") }}</text>
    <img
      class="top rightButton"
      if="{{ global.screenShape == 'rect' }}"
      src="/common/info_rect.png"
      @click="info"
    />
    <text class="title" elif="{{ global.screenShape == 'circle' }}" @click="info">
      {{ $t("appName") }}
    </text>
    <img else class="top" src="/common/info.png" @click="info" />
    <img
      class="top leftButton"
      if="{{ global.screenShape == 'rect' }}"
      src="/common/back_rect.png"
      @click="routeBack"
    />
    <swiper
      if="{{ contentVisible && !is_no_event }}"
      index="{{ swiperIndex }}"
      indicator="false"
      class="countdown-swiper"
      @change="onSwiperChange"
    >
      <div for="{{ slots }}">
        <div class="countdown-page">
          <div class="countdown-header" style="background-color: {{ $item.themeColor }}">
            <marquee
              if="{{ pageVisible && $item.nameOverflow && activeSourceIndex === $item.sourceIndex }}"
              id="home-marquee"
              class="countdown-event"
              scrollamount="{{ 20 }}"
              text-offset="{{ 20 }}"
            >
              {{ $item.name }}
            </marquee>
            <text else class="countdown-event">{{ $item.name }}</text>
          </div>
          <div class="countdown-body" @click="toggleDisplayMode($item.sourceIndex)">
            <text class="countdown-days" style="font-size: {{ $item.fontSize }}px;">
              {{ $item.displayText }}
            </text>
          </div>
          <div class="countdown-footer">
            <text class="countdown-date">{{ $t("targetDate", {date: $item.date}) }}</text>
          </div>
        </div>
      </div>
    </swiper>
    <div id="empty" if="{{ contentVisible && is_no_event }}">
      <img src="/common/empty.png" />
      <text id="emp">{{ $t("empty") }}</text>
    </div>
    <img
      if="{{ global.screenShape == 'rect' }}"
      class="bottom rightButton"
      src="/common/more_rect.png"
      @click="routeMore"
    />
    <img else class="bottom" src="/common/more.png" @click="routeMore" />
  </div>
</template>

<script>
import router from "@system.router"
import {showToast} from "@system.prompt"
import interconnect from "@system.interconnect"
import interconnectHub from "../../components/interconnectHub"

const DISPLAY_MODES = ["days", "weeks", "months", "years"]

const PROTOCOL_REQUEST_LIMIT = 32
const PROTOCOL_PAYLOAD_LIMIT = 16384

// 使用完整规范化 JSON，而非短哈希，避免属性顺序差异和哈希碰撞导致误判。
function canonicalProtocolValue(value) {
  if (Array.isArray(value)) return "[" + value.map(canonicalProtocolValue).join(",") + "]"
  if (value && typeof value === "object") {
    return (
      "{" +
      Object.keys(value)
        .sort()
        .map((key) => JSON.stringify(key) + ":" + canonicalProtocolValue(value[key]))
        .join(",") +
      "}"
    )
  }
  return JSON.stringify(value)
}

const BASE_FONT_SIZES = Object.freeze({
  band: Object.freeze({rect: 76, pill: 56}),
  watch: Object.freeze({rect: 92, circle: 92})
})

const LENGTH_FACTORS = Object.freeze([
  Object.freeze({max: 3, factor: 0.9}),
  Object.freeze({max: 5, factor: 0.75}),
  Object.freeze({max: 7, factor: 0.56}),
  Object.freeze({max: 9, factor: 0.48}),
  Object.freeze({max: 12, factor: 0.38}),
  Object.freeze({max: 99, factor: 0.3})
])

// 跑马灯只在当前可见卡片且名称估算超宽时启用；每个汉字按字号计宽，其余字符约 0.6 倍
const MARQUEE_CHAR_FACTOR = 0.6

function getNameMetrics() {
  const deviceType = global.deviceType || "watch"
  const screenShape = global.screenShape || "pill-shaped"
  if (deviceType === "watch") {
    return {fontSize: 28, width: 300 * 0.85}
  }
  if (deviceType === "band" && screenShape === "rect") {
    return {fontSize: 24, width: 256 * 0.85}
  }
  return {fontSize: 20, width: 178 * 0.85}
}

function isNameOverflow(name, fontSize, availableWidth) {
  let textWidth = 0
  for (let i = 0; i < name.length; i++) {
    textWidth += name.charCodeAt(i) > 0x2e7f ? fontSize : fontSize * MARQUEE_CHAR_FACTOR
  }
  return textWidth > availableWidth
}

let connect

export default {
  private: {
    time: "",
    slots: [],
    is_no_event: true,
    bgImage: "",
    pageVisible: false,
    contentVisible: false,
    activeSourceIndex: -1,
    swiperIndex: 0
  },

  onInit() {
    this.allEvents = 0
    this.currentDisplayModeIndex = 0
    this._currentSlot = 0
    this._currentSource = 0
    this._currentEventId = ""
    this._homeEvents = []
    this._destroyed = false
    this._needsRefresh = false
    this._messageHandler = null
    // 应用级账本：页面重建不能丢失已执行/仍在提交的请求。
    if (!global.__daymatterProtocolLedger) {
      global.__daymatterProtocolLedger = {sessionId: "", deviceId: "", requests: []}
    }
    this._protocolLedger = global.__daymatterProtocolLedger
    this._ticker = global.createMinuteTicker((dateChanged) => this.handleMinuteTick(dateChanged))
    connect = interconnectHub.getConnection(interconnect)
    if (!connect) return
    // 订阅应用级分发：处理器只在页面存活期间挂载，销毁时解除
    this._messageHandler = (message) => this.handleInterconnectMessage(message)
    interconnectHub.subscribeMessage(this._messageHandler)
  },

  handleInterconnectMessage(message) {
    if (this._destroyed) return
    // Base64 背景保留既有正常上传规模，解析前先限制总消息分配。
    if (!message || typeof message.data !== "string" || message.data.length > 262144) return
    let parsedData
    try {
      parsedData = JSON.parse(message.data)
    } catch (e) {
      console.error("JSON parse error:", e)
      return
    }

    if (!parsedData || typeof parsedData !== "object" || Array.isArray(parsedData)) return
    if (parsedData.type === "hello") {
      this._pluginSession = typeof parsedData.sessionId === "string" ? parsedData.sessionId : ""
      if (this._pluginSession && this._protocolLedger.sessionId !== this._pluginSession) {
        // 新会话只释放旧的完成记录；旧在途操作仍持有自己的上下文。
        this._protocolLedger.requests = this._protocolLedger.requests.filter(
          (item) => !item.response
        )
        this._protocolLedger.sessionId = this._pluginSession
        this._protocolLedger.deviceId = ""
      }
      this._pluginProtocolV2 = parsedData.protocolVersion >= 2
      this._pluginCapabilities = Array.isArray(parsedData.capabilities)
        ? parsedData.capabilities
        : []
      this.sendProtocolResponse({
        type: "capabilities",
        protocolVersion: 2,
        sessionId: this._pluginSession,
        handshakeId: parsedData.handshakeId,
        deviceId: parsedData.deviceId,
        screenWidth: global.screenSize && global.screenSize.width,
        screenHeight: global.screenSize && global.screenSize.height,
        capabilities: [
          "stableId",
          "mutationResult",
          "requestId",
          "listRequestId",
          "listBatches",
          "themeColor",
          "primaryId",
          "primaryMutation",
          "backupRestore",
          "lunarDate",
          "lunarYearly",
          "lunarTable:dm-hko-v1",
          "revision",
          "backgroundJpeg",
          "backgroundResult",
          "backgroundChunks",
          "yearlyRepeat",
          "displayUnit",
          "pinned",
          "category",
          "archived",
          "manualOrder",
          "sortMode"
        ]
      })
      return
    }
    if (parsedData.type === "capabilities") return
    if (parsedData.type === "backgroundChunk" || parsedData.type === "finishBG") {
      const request = this.findProtocolRequest(parsedData)
      if (!request || request.background !== true) return
      if (request.response) { this.sendProtocolResponse(request.response); return }
      this.receiveBackground(parsedData, request)
      return
    }
    if (parsedData && parsedData.type === "getRequestResult") {
      const prior = this.findProtocolRequest(parsedData)
      if (prior && prior.response) this.sendProtocolResponse(prior.response)
      else
        this.sendProtocolResponse({
          type: "requestStatus",
          requestId: parsedData.requestId,
          sessionId: parsedData.sessionId,
          deviceId: parsedData.deviceId,
          status: prior ? "processing" : "unknown"
        })
      return
    }
    if (parsedData && parsedData.type === "mutationResult") return
    const requestId = parsedData && parsedData.requestId
    if (requestId && this._pluginSession && parsedData.sessionId !== this._pluginSession) return
    let request = null
    const handlers = {
      getAllEvent: () =>
        this.handleGetAllEvent(
          requestId
            ? {
                requestId: requestId,
                sessionId: parsedData.sessionId,
                deviceId: parsedData.deviceId,
                batches:
                  parsedData.listBatches === true &&
                  (this._pluginCapabilities || []).includes("listBatches")
              }
            : null
        ),
      addEvent: () => this.handleAddEvent(parsedData, request),
      changeEvent: () => this.handleChangeEvent(parsedData, request),
      deleteEvent: () => this.handleDeleteEvent(parsedData, request),
      moveEvent: () =>
        global.eventStore.move(parsedData.id, parsedData.direction, (error, result) =>
          this.finishPluginMutation("changeSuccess", error, result, null, request)
        ),
      setSortMode: () =>
        global.eventStore.setSortMode(parsedData.sortMode, (error, result) =>
          this.finishPluginMutation("changeSuccess", error, result, null, request)
        ),
      setPrimary: () => {
        if (typeof parsedData.id !== "string" ||
            (parsedData.id === "" && (typeof parsedData.expectedPrimaryId !== "string" || !parsedData.expectedPrimaryId))) {
          this.finishProtocolRequest(request, {code: "INVALID_PRIMARY"}, null)
          return
        }
        global.eventStore.setPrimary(parsedData.id, (error, result) => {
          if (request) request.parts = {
            event: {ok: !error || error.code === "WATCHFACE_FAIL"},
            primary: {ok: !error || error.code === "WATCHFACE_FAIL", requested: true, code: (error && error.code) || ""},
            watchface: {ok: !error}
          }
          this.finishProtocolRequest(request, error, result)
          if (!this._destroyed && (!error || error.code === "WATCHFACE_FAIL")) this.afterMutation("changeSuccess")
        }, parsedData.expectedPrimaryId)
      },
      restoreBackup: () => global.eventStore.restoreBackup(parsedData, (error, result) =>
        this.finishPluginMutation("changeSuccess", error, result, null, request)),
      addBG: () => this.handleAddBG(parsedData, request),
      beginBG: () => {
        if (!request) return
        request.background = true
        this.receiveBackground(parsedData, request)
      }
    }

    const handler = Object.prototype.hasOwnProperty.call(handlers, parsedData.type)
      ? handlers[parsedData.type]
      : null
    if (handler) {
      if (
        requestId &&
        ["beginBG", "addBG", "addEvent", "changeEvent", "deleteEvent", "moveEvent", "setSortMode", "setPrimary", "restoreBackup"].includes(
          parsedData.type
        )
      ) {
        if (
          !this._pluginProtocolV2 ||
          !this._pluginCapabilities ||
          !this._pluginCapabilities.includes("requestId") ||
          parsedData.sessionId !== this._protocolLedger.sessionId ||
          typeof requestId !== "string" ||
          requestId.length > 128 ||
          typeof parsedData.deviceId !== "string" ||
          !parsedData.deviceId ||
          parsedData.deviceId.length > 128
        )
          return
        const fingerprint = canonicalProtocolValue(parsedData)
        if (fingerprint.length > (parsedData.type === "restoreBackup" ? 250 * 1024 : parsedData.type === "addBG" ? 140 * 1024 : PROTOCOL_PAYLOAD_LIMIT)) {
          this.rejectProtocolRequest(parsedData, "REQUEST_TOO_LARGE")
          return
        }
        const prior = this.findProtocolRequest(parsedData)
        if (prior) {
          if (prior.fingerprint !== fingerprint)
            this.rejectProtocolRequest(parsedData, "REQUEST_CONFLICT")
          else if (prior.response) this.sendProtocolResponse(prior.response)
          else if (prior.background) this.receiveBackground(parsedData, prior)
          else
            this.sendProtocolResponse({
              type: "requestStatus",
              requestId: requestId,
              sessionId: prior.sessionId,
              deviceId: prior.deviceId,
              status: "processing"
            })
          return
        }
        if (
          this._protocolLedger.deviceId &&
          this._protocolLedger.deviceId !== parsedData.deviceId
        ) {
          this.rejectProtocolRequest(parsedData, "REQUEST_DEVICE_MISMATCH")
          return
        }
        // 不淘汰仍可重试的请求，否则被淘汰的新增会再次执行。
        if (this._protocolLedger.requests.length >= PROTOCOL_REQUEST_LIMIT) {
          this.rejectProtocolRequest(parsedData, "REQUEST_CACHE_FULL")
          return
        }
        if (this._protocolLedger.requests.reduce((size, item) => size + item.fingerprint.length, 0) + fingerprint.length > 512 * 1024) {
          this.rejectProtocolRequest(parsedData, "REQUEST_CACHE_FULL")
          return
        }
        this._protocolLedger.deviceId = parsedData.deviceId
        request = {
          requestId: requestId,
          sessionId: parsedData.sessionId,
          deviceId: parsedData.deviceId,
          fingerprint: fingerprint,
          response: null
        }
        this._protocolLedger.requests.push(request)
      }
      handler()
    }
  },

  sendProtocolResponse(payload) {
    if (connect && payload) connect.send({data: payload})
  },

  findProtocolRequest(data) {
    return this._protocolLedger.requests.find(
      (item) =>
        item.requestId === data.requestId &&
        item.sessionId === data.sessionId &&
        item.deviceId === data.deviceId
    )
  },

  rejectProtocolRequest(data, code) {
    this.sendProtocolResponse({
      type: "mutationResult",
      requestId: data.requestId,
      sessionId: data.sessionId,
      deviceId: data.deviceId,
      ok: false,
      code: code
    })
  },

  finishProtocolRequest(request, error, result) {
    if (!request || !request.requestId) return
    if (request.response) return
    const response = {
      type: "mutationResult",
      requestId: request.requestId,
      sessionId: request.sessionId,
      deviceId: request.deviceId,
      ok: !error || error.code === "WATCHFACE_FAIL",
      revision: result && result.revision,
      code: error && error.code ? error.code : ""
    }
    if (result && result.sortMode) response.sortMode = result.sortMode
    if (result && typeof result.primaryId === "string") response.primaryId = result.primaryId
    if (request.parts) {
      response.event = request.parts.event
      response.primary = request.parts.primary
      response.watchface = request.parts.watchface
      response.ok = request.parts.event.ok
    }
    request.response = response
    this.sendProtocolResponse(response)
  },

  onShow() {
    this.pageVisible = true
    this.contentVisible = true
    this.time = global.getTime()
    this.loadBackground()
    this.completed()
    this._ticker.start()
  },

  onHide() {
    // 隐藏释放原始集合与槽位；保留稳定ID及位置供重新读取后恢复。
    this.pageVisible = false
    this.contentVisible = false
    this._homeEvents = []
    this.slots = []
    this.activeSourceIndex = -1
    this._ticker.stop()
  },

  onDestroy() {
    this._destroyed = true
    this._ticker.stop()
    if (this._messageHandler) {
      interconnectHub.unsubscribeMessage(this._messageHandler)
      this._messageHandler = null
    }
    this._homeEvents = []
    this.slots = []
    this.bgImage = ""
    this.activeSourceIndex = -1
    this._needsRefresh = false
    if (typeof global.tryRunGC === "function") global.tryRunGC()
  },

  handleMinuteTick(dateChanged) {
    if (this._destroyed) return
    this.time = global.getTime()
    if (dateChanged) {
      // 跨午夜后重新计算全部倒数天数
      this.completed()
    }
  },

  onReady() {
    router.clear()
  },

  formatEvent(event, mode, sourceIndex, nameMetrics, cachedStatus) {
    const recurringStatus = cachedStatus === undefined
      ? global.dateUtils.getRecurringStatus(event) : cachedStatus
    const status = recurringStatus || global.dateUtils.TODAY_STATUS
    let name = event.name
    let days
    let already = true
    let isToday = false
    let themeColor = event.themeColor

    if (status.state === "past") {
      name = name + this.$t("already")
      days = status.days
    } else if (status.state === "today") {
      days = 0
      isToday = true
    } else {
      name = name + this.$t("remaining")
      days = status.days
      already = false
    }

    // 根据事件状态调整主题色色调
    if (event.repeat === "yearly" && status.anniversary !== null)
      name = this.$t(status.state === "future" ? "homeAnnualFuture" : status.state === "past" ? "homeAnnualPast" : "homeAnnualToday", {
        name: event.name,
        count: status.anniversary
      })
    themeColor = global.adjustThemeColor(themeColor, already)

    // 根据显示模式生成显示文本和字体大小
    const displayInfo = this.getDisplayInfo(days, status.ymd, mode, isToday)
    if (event.calendar === "lunar" && !recurringStatus) {
      displayInfo.text = "--"
      isToday = false
    }

    return {
      id: event.id,
      displayUnit: mode,
      name,
      days: String(days),
      accurateDiff: status.ymd,
      displayText: displayInfo.text,
      fontSize: displayInfo.fontSize,
      date: status.occurrenceDate || event.date,
      already,
      themeColor,
      isToday,
      sourceIndex,
      nameOverflow: isNameOverflow(name, nameMetrics.fontSize, nameMetrics.width)
    }
  },

  getDisplayInfo(days, accurateDiff, mode, isToday) {
    if (isToday) {
      const todayText = this.$t("today")
      return {text: todayText, fontSize: this.calculateFontSize(todayText.length)}
    }

    // 如果不能显示当前模式，回退到纯天数
    if (!this.canShowMode(days, accurateDiff, mode, isToday)) {
      const text = days + this.$t("days")
      return {
        text,
        fontSize: this.calculateFontSize(text.length)
      }
    }

    const {
      years: accYears,
      months: accMonths,
      days: accDays
    } = accurateDiff || {years: 0, months: 0, days: 0}

    let text = ""
    let len = 1

    switch (mode) {
      case "weeks": {
        const weeks = Math.floor(days / 7)
        const remainingDays = days % 7
        text =
          remainingDays > 0
            ? `${weeks}${this.$t("weeks")}${remainingDays}${this.$t("days")}`
            : `${weeks}${this.$t("weeks")}`
        len = text.length
        break
      }
      case "months": {
        const totalMonths = accYears * 12 + accMonths
        text =
          accDays > 0
            ? `${totalMonths}${this.$t("months")}${accDays}${this.$t("days")}`
            : `${totalMonths}${this.$t("months")}`
        len = text.length
        break
      }
      case "years": {
        text = `${accYears}${this.$t("years")}`
        if (accMonths > 0) text += `${accMonths}${this.$t("months")}`
        if (accDays > 0) text += `${accDays}${this.$t("days")}`
        len = text.length
        break
      }
      case "days":
      default:
        text = days
        len = String(days).length
        break
    }

    return {
      text,
      fontSize: this.calculateFontSize(len)
    }
  },

  calculateFontSize(textLength) {
    // 根据设备类型和文字长度计算字体大小
    const deviceType = global.deviceType || "watch"
    const screenShape = global.screenShape || "pill-shaped"
    const isPillShaped = global.isPillShaped || false

    let baseSize
    if (deviceType === "band" && isPillShaped) {
      baseSize = BASE_FONT_SIZES.band.pill
    } else {
      baseSize = BASE_FONT_SIZES[deviceType]?.[screenShape] || 92
    }

    const factor = LENGTH_FACTORS.find((f) => textLength <= f.max)?.factor || 0.35
    return Math.floor(baseSize * factor)
  },

  toggleDisplayMode(index) {
    if (this._unitSaving) return
    // 获取当前事件的信息（用于判断能否切换到某个模式）
    const currentEvent = this.slots.find((slot) => slot.sourceIndex === index)
    if (!currentEvent) return
    const days = parseInt(currentEvent.days)
    const accurateDiff = currentEvent.accurateDiff
    const isToday =
      currentEvent.isToday !== undefined
        ? currentEvent.isToday
        : currentEvent.displayText === this.$t("today")

    // 尝试切换到下一个模式，如果无法显示则继续尝试
    let attempts = 0
    let modeIndex = DISPLAY_MODES.indexOf(currentEvent.displayUnit || "days")
    let newMode
    do {
      modeIndex = (modeIndex + 1) % DISPLAY_MODES.length
      newMode = DISPLAY_MODES[modeIndex]
      attempts++
    } while (
      !this.canShowMode(days, accurateDiff, newMode, isToday) &&
      attempts < DISPLAY_MODES.length
    )

    const apply = () => {
      const source = this._homeEvents.find((item) => item.id === currentEvent.id)
      if (source) source.displayUnit = newMode
      const event = this.slots.find((slot) => slot.id === currentEvent.id)
      if (!event) return
      event.displayUnit = newMode
      const eventDays = parseInt(event.days)
      const eventAccurateDiff = event.accurateDiff
      const eventIsToday =
        event.isToday !== undefined ? event.isToday : event.displayText === this.$t("today")
      const displayInfo = this.getDisplayInfo(eventDays, eventAccurateDiff, newMode, eventIsToday)
      if (event.displayText !== displayInfo.text) {
        event.displayText = displayInfo.text
      }
      if (event.fontSize !== displayInfo.fontSize) {
        event.fontSize = displayInfo.fontSize
      }
    }
    if (!currentEvent.id) {
      apply()
      return
    }
    this._unitSaving = true
    global.eventStore.update(currentEvent.id, {displayUnit: newMode}, (error) => {
      this._unitSaving = false
      if (this._destroyed) return
      if (error && error.code !== "WATCHFACE_FAIL") {
        this.showEventError(error)
        return
      }
      if (this.pageVisible) apply()
      else this._needsRefresh = true
      if (error) showToast({message: this.$t("watchfaceSyncFail"), duration: 2000})
    })
  },

  canShowMode(days, accurateDiff, mode, isToday) {
    if (isToday) return true
    const {years, months} = accurateDiff || {years: 0, months: 0}
    switch (mode) {
      case "days":
        return true
      case "weeks":
        return Math.floor(days / 7) >= 1
      case "months":
        return months > 0 || years > 0
      case "years":
        return years > 0
      default:
        return true
    }
  },

  completed() {
    global.eventStore.read((error, result) => {
      if (this._destroyed) return
      if (error) {
        // 读取失败不覆盖、不重建；仅在可见时提示
        if (this.pageVisible) showToast({message: this.$t("loadFail"), duration: 2000})
        return
      }
      if (!this.pageVisible) {
        // 隐藏页只标记需要刷新，不在隐藏 UI 上重建
        this._needsRefresh = true
        return
      }
      const events = result.events
      this.allEvents = events.length
      const refresh = global.eventOrder.createRefresh(global.dateUtils)
      this._homeEvents = global.eventOrder
        .select(events, result.sortMode || "created", global.dateUtils, {
          archived: false,
          home: true,
          refresh
        })
      this._needsRefresh = false
      this.setupSlots(refresh)
    })
  },

  createSlot(source, refresh) {
    const event = this._homeEvents[source]
    return this.formatEvent(event, event.displayUnit || "days", source, getNameMetrics(), refresh.getStatus(event))
  },

  setupSlots(refresh) {
    // 首页只生成最多三个展示对象，优先按稳定ID恢复；事件消失时回退相邻位置。
    const total = this._homeEvents.length
    this.is_no_event = total === 0
    this.swiperIndex = 0
    if (total === 0) {
      this.slots = []
      this.activeSourceIndex = -1
      this._currentSlot = 0
      this._currentSource = 0
      this._currentEventId = ""
      return
    }
    let source = this._currentSource
    const restored = this._homeEvents.findIndex((event) => event.id === this._currentEventId)
    if (restored >= 0) source = restored
    if (source < 0) source = 0
    if (source >= total) source = total - 1
    this._currentSource = source
    this._currentEventId = this._homeEvents[source].id
    if (total <= 3) {
      this.slots = this._homeEvents.map((event, index) => this.createSlot(index, refresh))
      this._currentSlot = source
      this.swiperIndex = source
    } else {
      this.slots = [
        this.createSlot(source, refresh),
        this.createSlot((source + 1) % total, refresh),
        this.createSlot((source - 1 + total) % total, refresh)
      ]
      this._currentSlot = 0
      this.swiperIndex = 0
    }
    this.activeSourceIndex = source
    this.resumeMarquee()
  },

  onSwiperChange(event) {
    const total = this._homeEvents.length
    if (total <= 1) return
    const slotCount = this.slots.length
    const newSlot = event && event.index >= 0 && event.index < slotCount ? event.index : 0
    const oldSlot = this._currentSlot
    if (newSlot === oldSlot) return

    let newSource
    if (total > 3 && slotCount === 3) {
      const step = (newSlot - oldSlot + 3) % 3
      if (step === 1) {
        // 前进：只为出屏槽位生成新的下一个事件展示对象。
        newSource = (this._currentSource + 1) % total
        this.slots[(newSlot + 1) % 3] = this.createSlot((newSource + 1) % total, global.eventOrder.createRefresh(global.dateUtils))
      } else if (step === 2) {
        // 后退：只为出屏槽位生成新的上一个事件展示对象。
        newSource = (this._currentSource - 1 + total) % total
        this.slots[(newSlot + 2) % 3] = this.createSlot((newSource - 1 + total) % total, global.eventOrder.createRefresh(global.dateUtils))
      } else {
        newSource = this._currentSource
      }
    } else {
      newSource = newSlot
    }

    this._currentSlot = newSlot
    this._currentSource = newSource
    this._currentEventId = this._homeEvents[newSource].id
    this.swiperIndex = newSlot
    this.activeSourceIndex = newSource
    this.resumeMarquee()
  },

  resumeMarquee() {
    const resume = () => {
      const marquee = this.$element("home-marquee")
      if (marquee && typeof marquee.start === "function") {
        marquee.start()
      }
    }
    if (typeof this.$nextTick === "function") {
      this.$nextTick(resume)
    } else {
      resume()
    }
  },

  afterMutation(successKey) {
    if (this._destroyed) return
    showToast({message: this.$t(successKey), duration: 2000})
    if (this.pageVisible) {
      this.completed()
    } else {
      // 隐藏页只标记需要刷新，等 onShow 再统一重建
      this._needsRefresh = true
    }
  },

  showEventError(error) {
    if (this._destroyed) return
    const code = error && error.code
    if (code === "NAME_REQUIRED") {
      showToast({message: this.$t("eventNameRequired"), duration: 2000})
      return
    }
    if (code === "NAME_TOO_LONG" || code === "NAME_INVALID") {
      showToast({
        message: this.$t(code === "NAME_TOO_LONG" ? "eventNameTooLong" : "eventNameInvalid"),
        duration: 2000
      })
      return
    }
    if (code === "DATE_INVALID") {
      showToast({message: this.$t("dateInvalid"), duration: 2000})
      return
    }
    if (code === "EVENT_LIMIT") {
      showToast({message: this.$t("tooManyEvents"), duration: 2000})
      return
    }
    if (code === "NOT_FOUND") {
      showToast({message: this.$t("eventNotFound"), duration: 2000})
      return
    }
    if (
      code === "INVALID_BOOLEAN" ||
      code === "INVALID_REPEAT" ||
      code === "INVALID_UNIT" ||
      code === "INVALID_CATEGORY" ||
      code === "INVALID_ORDER" ||
      code === "INVALID_MOVE" ||
      code === "INVALID_SORT" ||
      code === "ARCHIVED_PRIMARY" ||
      code === "INVALID_COLOR" ||
      code === "INVALID_EVENT"
    ) {
      showToast({message: this.$t("invalidEvent"), duration: 2000})
      return
    }
    const causeCode = error && error.cause ? error.cause.code : code
    showToast({message: this.$t("saveFail", {code: causeCode}), duration: 2000})
  },

  handleGetAllEvent(request) {
    if (this._destroyed) return
    global.eventStore.read((error, result) => {
      if (this._destroyed) return
      if (error) {
        if (request)
          this.sendProtocolResponse({
            type: "eventListError",
            requestId: request.requestId,
            sessionId: request.sessionId,
            deviceId: request.deviceId,
            code: "LIST_READ_FAILED"
          })
        showToast({message: this.$t("syncFail"), duration: 2000})
        return
      }
      const responseData = {
        data: result.events,
        primaryId: result.primaryId,
        revision: result.revision,
        sortMode: result.sortMode
      }
      if (request) {
        responseData.requestId = request.requestId
        responseData.sessionId = request.sessionId
        responseData.deviceId = request.deviceId
      }
      if (request && request.batches) {
        this.sendEventBatches(responseData)
        return
      }
      connect.send({
        // 同时给出稳定 ID / 主事件 / 修订号，插件按 ID 操作并可显示表盘主事件（E-02 / E-11）
        data: responseData,
        success: () => {
          if (this._destroyed) return
          showToast({message: this.$t("syncSuccess"), duration: 2000})
        },
        fail: () => {
          if (this._destroyed) return
          showToast({message: this.$t("syncFail"), duration: 2000})
        }
      })
    })
  },

  sendEventBatches(snapshot) {
    const batches = []
    let items = []
    const makeBatch = (data, index, count) => ({
      type: "eventListBatch",
      requestId: snapshot.requestId,
      sessionId: snapshot.sessionId,
      deviceId: snapshot.deviceId,
      revision: snapshot.revision,
      primaryId: snapshot.primaryId,
      sortMode: snapshot.sortMode,
      total: snapshot.data.length,
      batchIndex: index,
      batchCount: count,
      data: data
    })
    // UTF-8 长度上界：每个 UTF-16 单元最多 3 字节（代理对实际更小）。
    const fits = (data) => JSON.stringify(makeBatch(data, 199, 200)).length * 3 <= 8192
    for (let i = 0; i < snapshot.data.length; i++) {
      const event = snapshot.data[i]
      if (items.length >= 16 || !fits(items.concat([event]))) {
        if (items.length) batches.push(items)
        items = []
      }
      if (!fits([event])) {
        this.sendProtocolResponse({
          type: "eventListError",
          requestId: snapshot.requestId,
          sessionId: snapshot.sessionId,
          deviceId: snapshot.deviceId,
          code: "LIST_ITEM_TOO_LARGE"
        })
        return
      }
      items.push(event)
    }
    if (items.length || !batches.length) batches.push(items)
    let index = 0
    const sendNext = () => {
      if (this._destroyed || index >= batches.length) return
      const current = index++
      connect.send({
        data: makeBatch(batches[current], current, batches.length),
        success: sendNext,
        fail: () =>
          this.sendProtocolResponse({
            type: "eventListError",
            requestId: snapshot.requestId,
            sessionId: snapshot.sessionId,
            deviceId: snapshot.deviceId,
            code: "LIST_SEND_FAILED"
          })
      })
    }
    sendNext()
  },

  // 插件消息里的表盘主事件标记：true / false 生效，缺省或非法值不改变主事件
  readWatchfaceFlag(value) {
    if (value === true || value === "true") return true
    if (value === false || value === "false") return false
    return null
  },

  // 分项结果：事件数据已提交但表盘文件失败时单独报告，不当作整体失败
  finishPluginMutation(messageKey, error, result, wanted, request) {
    const eventSaved = !error || error.code === "WATCHFACE_FAIL"
    if (request)
      request.parts = {
        event: {ok: eventSaved},
        primary: {ok: null, requested: wanted !== null},
        watchface: {ok: eventSaved ? !(error && error.code === "WATCHFACE_FAIL") : null}
      }
    if (error) {
      if (!eventSaved) {
        this.finishProtocolRequest(request, error, result)
        if (this._destroyed) return
        this.showEventError(error)
        return
      }
    }
    const eventId = result && result.event ? result.event.id : null
    if (wanted === null || !eventId) {
      this.finishProtocolRequest(request, error, result)
      if (this._destroyed) return
      this.afterMutation(messageKey)
      if (error) showToast({message: this.$t("watchfaceSyncFail"), duration: 2000})
      return
    }
    global.eventStore.setPrimary(wanted ? eventId : "", (primaryError, primaryResult) => {
      if (request) {
        request.parts.primary.ok = !primaryError || primaryError.code === "WATCHFACE_FAIL"
        request.parts.primary.code = (primaryError && primaryError.code) || ""
        request.parts.watchface.ok = request.parts.primary.ok
          ? !(primaryError && primaryError.code === "WATCHFACE_FAIL")
          : request.parts.watchface.ok
      }
      this.finishProtocolRequest(request, primaryError, primaryResult || result)
      if (this._destroyed) return
      if (primaryError && primaryError.code !== "WATCHFACE_FAIL") {
        this.showEventError(primaryError)
        return
      }
      this.afterMutation(messageKey)
      if (primaryError) showToast({message: this.$t("watchfaceSyncFail"), duration: 2000})
    })
  },

  handleAddEvent(data, request) {
    if (this._destroyed) return
    global.eventStore.add(data, (error, result) => {
      this.finishPluginMutation(
        "addSuccess",
        error,
        result,
        this.readWatchfaceFlag(data.watchface),
        request
      )
    })
  },

  handleChangeEvent(data, request) {
    if (this._destroyed) return
    // 只提交消息里出现的字段，未提供的字段由存储层原样保留
    const patch = {
      calendar: data.calendar,
      lunarDate: data.lunarDate,
      lunarTableVersion: data.lunarTableVersion,
      lunarLeapPolicy: data.lunarLeapPolicy,
      lunarShortMonthPolicy: data.lunarShortMonthPolicy,
      name: data.name,
      date: data.date,
      on_index: data.on_index,
      IFStaringDay: data.IFStaringDay,
      themeColor: data.themeColor,
      repeat: data.repeat,
      displayUnit: data.displayUnit,
      pinned: data.pinned,
      archived: data.archived,
      category: data.category
    }
    const onDone = (error, result) => {
      this.finishPluginMutation(
        "changeSuccess",
        error,
        result,
        this.readWatchfaceFlag(data.watchface),
        request
      )
    }
    if (data.id !== undefined) {
      global.eventStore.update(String(data.id), patch, onDone)
    } else {
      global.eventStore.updateByIndex(data.index, patch, onDone)
    }
  },

  handleDeleteEvent(data, request) {
    if (this._destroyed) return
    const onDone = (error, result) => {
      this.finishPluginMutation("deleteSuccess", error, result, null, request)
    }
    if (data.id !== undefined) {
      global.eventStore.remove(String(data.id), onDone)
    } else {
      global.eventStore.remove(data.index, onDone)
    }
  },

  handleAddBG(data, request) {
    if (this._destroyed) return
    const {bgBase64} = data
    if (!bgBase64) {
      this.finishProtocolRequest(request, {code: "BACKGROUND_EMPTY"})
      showToast({message: "No image data", duration: 2000})
      return
    }

    global.backgroundStore.save(bgBase64, (error, uri) => {
      this.finishProtocolRequest(request, error, error ? null : {backgroundUri: uri})
      if (this._destroyed) return
      if (error) {
        showToast({message: this.$t("bgSaveFail", {code: error.code}), duration: 2000})
        return
      }
      this._backgroundLoadToken = (this._backgroundLoadToken || 0) + 1
      if (this.pageVisible) this.bgImage = uri
      else this._needsRefresh = true
      showToast({message: this.$t("bgUpdateSuccess"), duration: 2000})
    })
  },

  receiveBackground(data, request) {
    global.backgroundStore.receive(data, (error, result) => {
      if (error || (result && result.complete)) {
        this.finishProtocolRequest(request, error)
        if (!error && !this._destroyed) {
          this._backgroundLoadToken = (this._backgroundLoadToken || 0) + 1
          if (this.pageVisible) this.bgImage = result.uri
          else this._needsRefresh = true
        }
      } else if (result) {
        this.sendProtocolResponse({type:"backgroundAck", sessionId:data.sessionId,
          requestId:data.requestId, deviceId:data.deviceId, next:result.next})
      }
    })
  },

  loadBackground() {
    const token = (this._backgroundLoadToken || 0) + 1
    this._backgroundLoadToken = token
    global.backgroundStore.load((error, uri) => {
      if (this._destroyed || !this.pageVisible || token !== this._backgroundLoadToken) return
      // 扫描失败保留已有背景，无自定义背景时保持空节点。
      if (!error) this.bgImage = uri
    })
  },

  info() {
    router.push({
      uri: "/pages/about"
    })
  },

  routeBack() {
    router.back()
  },

  routeMore() {
    if (this.allEvents === 0) {
      router.push({
        uri: "/pages/edit",
        params: {
          extend: "true",
          callback_uri: "/pages/index"
        }
      })
    } else {
      router.push({uri: "/pages/list"})
    }
  }
}
</script>

<style>
@import "../../common/app.css";

.index-page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  color: white;
  background-color: black;
}

.bg {
  position: absolute;
  top: 0;
  left: 0;
}

.countdown-swiper {
  width: 178px;
  height: 178px;
}

.countdown-page {
  display: flex;
  flex-direction: column;
  width: 178px;
  height: 178px;
  border-radius: 20px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-color: #fff;
}

#empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

#emp {
  font-weight: bold;
  margin-top: 12px;
}

.countdown-header {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 40px;
}

.countdown-event {
  font-size: 20px;
  text-align: center;
  width: 85%;
  font-weight: bold;
  color: white;
  lines: 1;
  text-overflow: ellipsis;
}

.countdown-body {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  border-radius: 1px; /* 这个是解决9和9Pro不知道为啥加圆角会少一点像素的问题的 */
  flex: 1;
}

.countdown-days {
  text-align: center;
  font-size: 56px;
  font-weight: bold;
  color: #000;
}

.countdown-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 36px;
  background-color: #efefef;
}

.countdown-date {
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  color: #666666;
}

@media (device-type: band) and (shape: rect) {
  .countdown-swiper {
    width: 256px;
    height: 256px;
  }

  .countdown-page {
    width: 256px;
    height: 256px;
    border-radius: 24px;
  }

  .countdown-header {
    height: 56px;
  }

  .countdown-event {
    font-size: 24px;
  }

  .countdown-footer {
    height: 48px;
  }

  .countdown-date {
    font-size: 20px;
  }

  .countdown-days {
    font-size: 76px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .countdown-swiper {
    width: 300px;
    height: 300px;
  }

  .countdown-page {
    width: 300px;
    height: 300px;
    border-radius: 32px;
  }

  .countdown-header {
    height: 66px;
  }

  .countdown-event {
    font-size: 28px;
  }

  .countdown-footer {
    height: 64px;
  }

  .countdown-date {
    font-size: 24px;
  }

  .countdown-days {
    font-size: 92px;
  }
}

@media (device-type: watch) and (shape: circle) {
  .countdown-swiper {
    width: 300px;
    height: 300px;
  }

  .countdown-page {
    width: 300px;
    height: 300px;
    border-radius: 32px;
  }

  .countdown-header {
    height: 66px;
  }

  .countdown-event {
    font-size: 28px;
  }

  .countdown-footer {
    height: 64px;
  }

  .countdown-date {
    font-size: 24px;
  }

  .countdown-days {
    font-size: 92px;
  }
}
</style>
